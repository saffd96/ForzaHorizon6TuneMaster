+614,Zenvo,TSR-S,2019,R,906,RWD,878,1547,Hypercars
+'@
+
+# ── Swap groups by CarType ─────────────────────────────────────────────────────
+
+$swapGroups = @{
+    # Very small cars
+    'Eclectic Domestics' = @('i4_motorbike','i4_1600_vvt','i4_2000_vvt')
+    'Cult Cars'          = @('i4_motorbike','i4_1600_vvt','i4_2000_vvt')
+    'Buggies'            = @('i4_1600_vvt','i4_2000_280hp','i6_2600_tt_rb26','v8_6200_ls3')
+    'UTV\'s'             = @()  # No swaps
+
+    # Hot hatches — I4/I6 focus
+    'Hot Hatch'          = @('i4_1600_vvt','i4_1600_rally','i4_2000_280hp','i4_2000_306hp','i6_2600_tt_rb26','f4_2000_rally','i4_2100_tt')
+    'Retro Hot Hatch'    = @('i4_1600_vvt','i4_1600_rally','i4_2000_280hp','i6_2600_tt_rb26','v8_6200_ls3')
+    'Super Hot Hatch'    = @('i4_1600_rally','i4_2000_280hp','i4_2000_306hp','i4_2100_tt','i6_2600_tt_rb26','v6_3500_tt_450')
+
+    # Sports cars
+    'Classic Sports Cars'  = @('i4_1600_rally','i4_2000_280hp','i6_2600_tt_rb26','v8_6200_ls3','v8_7000_ls7','v8_5200_voodoo','rotor_2r_tt')
+    'Retro Sports Cars'    = @('i4_2000_280hp','i6_2600_tt_rb26','i6_3200','v6_3500_tt_450','v8_6200_ls3','v8_7000_ls7','v8_5200_voodoo','rotor_4r_race')
+    'Modern Sports Cars'   = @('i4_2000_306hp','i4_2100_tt','i6_2600_tt_rb26','v6_3500_tt_450','v8_6200_ls3','v8_5200_voodoo','v8_7000_ls7','v10_5200')
+    'Drift Cars'           = @('i6_2600_tt_rb26','v8_6200_ls3','v8_6200_ls9','v8_7000_ls7','v8_5200_voodoo','v10_5200','rotor_4r_race')
+
+    # Saloons and GT
+    'Retro Super Saloons'  = @('i6_2600_tt_rb26','v6_3500_tt_450','v8_6200_ls3','v8_7000_ls7','v8_5200_voodoo')
+    'Modern Super Saloons' = @('v6_3500_tt_450','v8_6200_ls3','v8_6200_ls9','v8_7000_ls7','v10_5200')
+    'GT Cars'              = @('v6_3500_tt_630','v8_6200_ls3','v8_5200_voodoo','v8_7000_ls7','v10_5200','v12_6500')
+    'Super GT'             = @('v8_6200_ls9','v8_7000_ls7','v8_7200_race','v10_5200','v10_8400','v12_6500')
+
+    # Muscle
+    'Classic Muscle'  = @('v8_4000','v8_5000_dsc','v8_6200_ls3','v8_5200_voodoo','v8_7000_ls7','v10_5200','v10_8400')
+    'Retro Muscle'    = @('v8_4000','v8_5200_voodoo','v8_6200_ls3','v8_6200_ls9','v8_7000_ls7','v10_5200')
+    'Modern Muscle'   = @('v8_5200_voodoo','v8_6200_ls3','v8_6200_ls9','v8_5000_dsc','v8_7000_ls7','v8_7200_race','v10_5200','v10_8400')
+    'Rods and Customs'= @('v8_4000','v8_6200_ls3','v8_7000_ls7','v8_5200_voodoo')
+
+    # Supercars — limited swaps
+    'Retro Supercars'  = @('v8_7000_ls7','v8_7200_race','v10_5200','v12_6500','v12_7700_tt')
+    'Modern Supercars' = @('v8_7200_race','v10_8400','v12_6500','v12_7700_tt')
+    'Hypercars'        = @()  # Locked
+    'Extreme Track Toys' = @()  # Locked
+
+    # Race-built — no swaps
+    'Classic Racers'   = @()
+    'Retro Racers'     = @()
+    'Rally Monsters'   = @()
+    'Retro Racers'     = @()
+
+    # Rally
+    'Classic Rally'    = @('i4_1600_vvt','i4_1600_rally','i4_2000_280hp','f4_2000_rally','i6_2600_tt_rb26')
+    'Retro Rally'      = @('i4_1600_rally','i4_2000_280hp','f4_2000_rally','f4_2500_turbo','i6_2600_tt_rb26')
+    'Modern Rally'     = @('i4_2000_280hp','f4_2000_rally','f4_2500_turbo','i6_2600_tt_rb26','v6_3500_tt_450')
+
+    # Track toys
+    'Track Toys'       = @('i6_2600_tt_rb26','v6_3500_tt_630','v8_5200_voodoo','v8_6200_ls3','v8_7000_ls7','v10_5200','rotor_4r_race')
+
+    # SUVs / Trucks
+    'Sports Utility Heroes' = @('v6_3500_tt_450','v8_6200_ls3','v8_6200_ls9','v8_7000_ls7','v8_diesel_6700')
+    'Pickups & 4x4\'s' = @('v8_4000','v8_6200_ls3','v8_7000_ls7','v8_diesel_6700','v8_5800_dsc')
+    'Offroad'          = @('v6_3500_tt_450','v8_6200_ls3','v8_7000_ls7','v8_diesel_6700')
+    'Unlimited Offroad'= @('v8_6200_ls3','v8_7000_ls7','v8_7200_race','v8_diesel_6700','i6t_diesel_12800')
+    'Unlimited Buggies'= @('v8_6200_ls3','v8_7000_ls7','v8_7200_race','v8_7400_tt')
+    'Utility Heroes'   = @('v8_4000','v8_6200_ls3','v8_diesel_6700')
+
+    # Rare
+    'Rare Classics'    = @('i6_2600_tt_rb26','v8_6200_ls3','v8_7000_ls7','v10_5200')
+}
+
+# Electric makes — no ICE swaps, electric motor swaps only
+$electricMakes = @('Rivian','Lucid','Rimac')
+$electricModels = @('RS E-TRON GT','IX XDRIVE50','I8','IONIQ 5 N','NEVERA','EVIJA','TAYCAN','F-150 LIGHTNING','HONGGUANG MINI EV','E ','HUMMER EV','CT4','CT5')
+
+function Get-PowertrainType([string]$make, [string]$model) {
+    if ($electricMakes -contains $make) { return "Electric" }
+    foreach ($em in $electricModels) { if ($model -match [regex]::Escape($em.Trim())) { return "Electric" } }
+    if ($model -match "LaFerrari|SF90|P1|918 SPYDER|Regera|ONE$") { return "Hybrid" }
+    return "ICE"
+}
+
+function Get-AspirationType([string]$make, [string]$model, [string]$powertrainType) {
+    if ($powertrainType -ne "ICE") { return "Electric" }
+    if ($model -match "TURBO|TT|GT-R|Skyline|Supra RZ|Lancer Evo|WRX STI|RS[0-9]|Cosworth|S4|488|F8|296|Portofino|911 TURBO|GT2") { return "SingleTurbo" }
+    if ($model -match "TWIN TURBO|TT RS|NSX|Venom") { return "TwinTurbo" }
+    if ($model -match "SUPERCHARGED|DSC|COBRA|Hellcat") { return "PositiveDisplacement" }
+    return "Natural"
+}
+
+function Get-EnginePosition([string]$carType, [string]$model) {
+    if ($model -match "MR2|NSX|Miura|Dino|F50|LaFerrari|SF90|488|F8|296|Sesto|Huracan|Gallardo|Aventador|Murcielago|Diablo|Sian|Revuelto|Centenario|Veneno") { return "Mid" }
+    if ($carType -match "Hypercars|Extreme Track Toys|Classic Racers|Retro Racers") { return "Mid" }
+    return "Front"
+}
+
+function Make-Id([string]$make, [string]$model, [int]$year) {
+    $s = "$make $model $year" -replace "[^a-zA-Z0-9 ]","" -replace "\s+","-" -replace "-+","-"
+    return $s.ToLower().Trim("-")
+}
+
+# ── Process ────────────────────────────────────────────────────────────────────
+
+$cars = @()
+$idMap = @{}
+
+foreach ($line in $kudos.Split("`n")) {
+    $line = $line.Trim()
+    if ([string]::IsNullOrEmpty($line)) { continue }
+
+    $p = $line.Split(",")
+    if ($p.Count -lt 10) { continue }
+
+    $kudosId  = $p[0].Trim()
+    $make     = $p[1].Trim()
+    $model    = $p[2].Trim()
+    $year     = [int]$p[3]
+    $class    = $p[4].Trim()
+    $pi       = [int]$p[5]
+    $drive    = $p[6].Trim()
+    $kw       = [int]$p[7]
+    $mass     = [int]$p[8]
+    $carType  = ($p[9..($p.Count-1)] -join ",").Trim()
+
+    $hp       = [int]($kw * 1.341)
+    $torqueNm = [int]($hp * 1.2)  # rough estimate
+    $maxRpm   = if ($hp -lt 200) { 6500 } elseif ($hp -lt 400) { 7000 } elseif ($hp -lt 700) { 7500 } else { 8000 }
+
+    $powertrainType  = Get-PowertrainType $make $model
+    $aspirationType  = Get-AspirationType $make $model $powertrainType
+    $enginePosition  = Get-EnginePosition $carType $model
+
+    # Per-car engine swaps
+    $swaps = @()
+    if ($powertrainType -eq "Electric") {
+        $swaps = @('electric_235hp','electric_670hp','electric_1893hp')
+    } elseif ($swapGroups.ContainsKey($carType)) {
+        $swaps = $swapGroups[$carType]
+    }
+
+    $id = Make-Id $make $model $year
+    if ($idMap.ContainsKey($id)) { $idMap[$id]++; $id = "$id-$($idMap[$id])" }
+    else { $idMap[$id] = 0 }
+
+    $cars += [PSCustomObject]@{
+        id                = $id
+        kudosPrimeId      = [int]$kudosId
+        make              = $make
+        model             = $model
+        year              = $year
+        stockPI           = $pi
+        stockClass        = $class
+        carType           = $carType
+        driveType         = $drive
+        powertrainType    = $powertrainType
+        aspirationType    = $aspirationType
+        enginePosition    = $enginePosition
+        defaultHP         = $hp
+        defaultMassKg     = $mass
+        defaultTorqueNm   = $torqueNm
+        defaultMaxRpm     = $maxRpm
+        defaultDisplacementL = [float]([math]::Round($hp / 120.0, 1))
+        defaultCylinders  = if ($hp -lt 150) { 4 } elseif ($hp -lt 350) { 4 } elseif ($hp -lt 550) { 6 } elseif ($hp -lt 750) { 8 } else { 8 }
+        engineSwaps       = $swaps
+    }
+}
+
+$outPath = "U:\Forza Horizon 6 Tune Master\Forza Horizon 6 Tune Master\Data\fh6_cars.json"
+$cars | ConvertTo-Json -Depth 4 | Set-Content -Path $outPath -Encoding UTF8
+Write-Host "Generated $($cars.Count) cars -> $outPath"
