+<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.BuildResultView"
+             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
+             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+             xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
+             Background="{StaticResource BgBrush}">
+    <UserControl.Resources>
+        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
+        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
+        <cv:NullToVisibilityConverter        x:Key="NullToCollapsed"/>
+        <cv:InverseNullToVisibilityConverter x:Key="NullToVisible"/>
+    </UserControl.Resources>
+
+    <Grid>
+        <!-- Empty state -->
+        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
+                    Visibility="{Binding BuildResult, Converter={StaticResource NullToVisible}}">
+            <TextBlock Text="🔧" FontSize="40" HorizontalAlignment="Center"
+                       Foreground="{StaticResource TextMutedBrush}"/>
+            <TextBlock Text="Сборка не рассчитана"
+                       Foreground="{StaticResource TextMutedBrush}"
+                       FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,4"/>
+            <TextBlock Text="Выберите авто, класс и нажмите «Сгенерировать»"
+                       Foreground="{StaticResource TextMutedBrush}"
+                       FontSize="11" HorizontalAlignment="Center"/>
+        </StackPanel>
+
+        <!-- Result -->
+        <ScrollViewer VerticalScrollBarVisibility="Auto"
+                      Visibility="{Binding BuildResult, Converter={StaticResource NullToCollapsed}}">
+            <StackPanel Margin="20,16,20,24">
+
+                <!-- ── Header ────────────────────────────────────────── -->
+                <TextBlock Style="{StaticResource SectionHeader}"
+                           Visibility="{Binding BuildResult.IsUpgrade, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
+                    <Run Text="РЕКОМЕНДУЕМЫЕ ДЕТАЛИ  →  КЛАСС"/>
+                    <Run Text="{Binding BuildResult.TargetClass, Mode=OneWay, FallbackValue=''}" Foreground="{StaticResource AccentBrush}"/>
+                </TextBlock>
+
+                <TextBlock Style="{StaticResource SectionHeader}"
+                           Visibility="{Binding BuildResult.IsInClassUpgrade, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
+                    <Run Text="УЛУЧШЕНИЯ В КЛАССЕ"/>
+                    <Run Text="{Binding BuildResult.TargetClass, Mode=OneWay, FallbackValue=''}" Foreground="{StaticResource CyanBrush}"/>
+                </TextBlock>
+
+                <!-- ── Downgrade — not supported ─────────────────────── -->
+                <Border Style="{StaticResource SectionCard}"
+                        Visibility="{Binding BuildResult.IsDowngrade, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
+                    <StackPanel>
+                        <TextBlock Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="SemiBold"
+                                   Text="Снизить PI невозможно" Margin="0,0,0,4"/>
+                        <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap">
+                            <Run Text="В FH6 нет балласта или ограничителя мощности."/>
+                            <Run Text="PI автомобиля ("/>
+                            <Run Text="{Binding SelectedCarEntry.StockPI, Mode=OneWay, FallbackValue=''}" Foreground="{StaticResource AccentBrush}"/>
+                            <Run Text=") превышает максимум класса "/>
+                            <Run Text="{Binding BuildResult.TargetClass, Mode=OneWay, FallbackValue=''}" Foreground="{StaticResource AccentBrush}"/>
+                            <Run Text=". Выберите другой автомобиль или более высокий класс."/>
+                        </TextBlock>
+                    </StackPanel>
+                </Border>
+
+                <!-- ── AlreadyMaxed ───────────────────────────────────── -->
+                <Border Style="{StaticResource SectionCard}"
+                        Visibility="{Binding BuildResult.AlreadyMaxed, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
+                    <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap">
+                        <Run Text="✓ Автомобиль уже на максимуме класса "/>
+                        <Run Text="{Binding BuildResult.TargetClass, Mode=OneWay, FallbackValue=''}" FontWeight="Bold"/>
+                        <Run Text=" (PI "/>
+                        <Run Text="{Binding SelectedCarEntry.StockPI, Mode=OneWay, FallbackValue=''}"/>
+                        <Run Text="). Дальнейшие апгрейды в этом классе невозможны."/>
+                    </TextBlock>
+                </Border>
+
+                <!-- ── TargetUnreachable ──────────────────────────────── -->
+                <Border Style="{StaticResource SectionCard}"
+                        Visibility="{Binding BuildResult.TargetUnreachable, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
+                    <TextBlock Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"
+                               Text="✗ Целевой класс недостижим с доступными апгрейдами."/>
+                </Border>
+
+                <!-- ── Steps table ────────────────────────────────────── -->
+                <Border Style="{StaticResource SectionCard}"
+                        Visibility="{Binding HasBuildResult, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
+                    <StackPanel>
+                        <!-- Column headers -->
+                        <Grid Margin="0,0,0,6">
+                            <Grid.ColumnDefinitions>
+                                <ColumnDefinition Width="110"/>
+                                <ColumnDefinition Width="*"/>
+                                <ColumnDefinition Width="46"/>
+                            </Grid.ColumnDefinitions>
+                            <TextBlock Grid.Column="0" Text="Категория"    Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
+                            <TextBlock Grid.Column="1" Text="Рекомендация" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
+                            <TextBlock Grid.Column="2" Text="PI"           Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
+                        </Grid>
+                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,6"/>
+
+                        <!-- Upgrade rows -->
+                        <ItemsControl ItemsSource="{Binding BuildResult.Steps}">
+                            <ItemsControl.ItemTemplate>
+                                <DataTemplate>
+                                    <Grid Margin="0,5,0,0">
+                                        <Grid.ColumnDefinitions>
+                                            <ColumnDefinition Width="110"/>
+                                            <ColumnDefinition Width="*"/>
+                                            <ColumnDefinition Width="46"/>
+                                        </Grid.ColumnDefinitions>
+
+                                        <TextBlock Grid.Column="0" Text="{Binding CategoryLabel}"
+                                                   Foreground="{StaticResource TextDimBrush}" FontSize="12"
+                                                   VerticalAlignment="Top"/>
+
+                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
+                                            <TextBlock Foreground="{StaticResource TextBrush}"
+                                                       FontSize="12" FontWeight="SemiBold">
+                                                <Run Text="→ "/>
+                                                <Run Text="{Binding RecommendedLabel, Mode=OneWay}"/>
+                                            </TextBlock>
+                                            <TextBlock Text="{Binding Note}"
+                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10">
+                                                <TextBlock.Style>
+                                                    <Style TargetType="TextBlock">
+                                                        <Setter Property="Visibility" Value="Visible"/>
+                                                        <Style.Triggers>
+                                                            <DataTrigger Binding="{Binding Note}" Value="">
+                                                                <Setter Property="Visibility" Value="Collapsed"/>
+                                                            </DataTrigger>
+                                                        </Style.Triggers>
+                                                    </Style>
+                                                </TextBlock.Style>
+                                            </TextBlock>
+                                        </StackPanel>
+
+                                        <!-- PI delta: green + for upgrade, red − for downgrade -->
+                                        <TextBlock Grid.Column="2" FontSize="12"
+                                                   HorizontalAlignment="Right" VerticalAlignment="Top">
+                                            <TextBlock.Style>
+                                                <Style TargetType="TextBlock">
+                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
+                                                    <Style.Triggers>
+                                                        <DataTrigger Binding="{Binding IsNegative}" Value="True">
+                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
+                                                        </DataTrigger>
+                                                    </Style.Triggers>
+                                                </Style>
+                                            </TextBlock.Style>
+                                            <Run Text="{Binding PISign, Mode=OneWay}"/>
+                                            <Run Text="{Binding PIAbsolute, Mode=OneWay}"/>
+                                        </TextBlock>
+
+                                    </Grid>
+                                </DataTemplate>
+                            </ItemsControl.ItemTemplate>
+                        </ItemsControl>
+
+                        <!-- Separator + summary -->
+                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,10,0,8"/>
+                        <Grid>
+                            <Grid.ColumnDefinitions>
+                                <ColumnDefinition Width="*"/>
+                                <ColumnDefinition Width="Auto"/>
+                            </Grid.ColumnDefinitions>
+                            <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center">
+                                <Run Text="PI:" Foreground="{StaticResource TextDimBrush}"/>
+                                <Run Text="{Binding SelectedCarEntry.StockPI, Mode=OneWay, FallbackValue=''}"
+                                     Foreground="{StaticResource TextBrush}"/>
+                                <Run Text=" → " Foreground="{StaticResource TextMutedBrush}"/>
+                                <Run Text="{Binding BuildResult.AchievedPI, Mode=OneWay, FallbackValue=''}"
+                                     Foreground="{StaticResource CyanBrush}" FontWeight="Bold"/>
+                                <Run Text=" (" Foreground="{StaticResource TextMutedBrush}"/>
+                                <Run Text="{Binding BuildResult.AchievedClass, Mode=OneWay, FallbackValue=''}"
+                                     Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
+                                <Run Text=")" Foreground="{StaticResource TextMutedBrush}"/>
+                            </TextBlock>
+                            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center">
+                                <TextBlock.Style>
+                                    <Style TargetType="TextBlock">
+                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
+                                        <Style.Triggers>
+                                            <DataTrigger Binding="{Binding BuildResult.IsDowngrade}" Value="True">
+                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
+                                            </DataTrigger>
+                                        </Style.Triggers>
+                                    </Style>
+                                </TextBlock.Style>
+                                <Run Text="{Binding BuildResult.TotalPISignLabel, Mode=OneWay, FallbackValue=''}"/>
+                                <Run Text="{Binding BuildResult.TotalPIAbsolute, Mode=OneWay, FallbackValue=''}"
+                                     FontWeight="SemiBold"/>
+                                <Run Text=" PI" Foreground="{StaticResource TextMutedBrush}"/>
+                            </TextBlock>
+                        </Grid>
+                    </StackPanel>
+                </Border>
+
+                <!-- Apply button -->
+                <Button Content="🔧 Собрать и настроить"
+                        Style="{StaticResource PrimaryButton}"
+                        Command="{Binding ApplyBuildCommand}"
+                        Padding="0,10" Margin="0,12,0,0"
+                        HorizontalAlignment="Stretch"
+                        FontSize="{DynamicResource FontNormal}"
+                        Visibility="{Binding HasBuildResult, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
+
+
+            </StackPanel>
+        </ScrollViewer>
+    </Grid>
+</UserControl>
