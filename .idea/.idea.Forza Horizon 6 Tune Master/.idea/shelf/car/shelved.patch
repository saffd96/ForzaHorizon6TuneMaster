+using System.IO;
+using System.Reflection;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace Forza_Horizon_6_Tune_Master.Data;
+
+public static class CarDatabase
+{
+    private static IReadOnlyList<CarEntry>?    _cars;
+    private static UpgradeTableData?           _upgrades;
+    private static readonly object             _lock = new();
+
+    private static readonly JsonSerializerOptions _jsonOpts = new()
+    {
+        PropertyNameCaseInsensitive = true,
+        NumberHandling = JsonNumberHandling.AllowReadingFromString
+    };
+
+    // ── Cars ─────────────────────────────────────────────────────────────────
+
+    public static IReadOnlyList<CarEntry> GetAll()
+    {
+        if (_cars != null) return _cars;
+        lock (_lock) { _cars ??= LoadCars(); }
+        return _cars;
+    }
+
+    public static IReadOnlyList<CarEntry> Search(string query)
+    {
+        if (string.IsNullOrWhiteSpace(query)) return GetAll();
+        var q = query.Trim().ToLowerInvariant();
+        return GetAll()
+            .Where(c => c.Make.Contains(q, StringComparison.OrdinalIgnoreCase)
+                     || c.Model.Contains(q, StringComparison.OrdinalIgnoreCase)
+                     || c.Year.ToString().Contains(q)
+                     || $"{c.Make} {c.Model}".Contains(q, StringComparison.OrdinalIgnoreCase))
+            .ToList();
+    }
+
+    public static CarEntry? Find(string id) =>
+        GetAll().FirstOrDefault(c => c.Id == id);
+
+    public static int Count => GetAll().Count;
+
+    public static string StatusLabel
+    {
+        get
+        {
+            var c = GetAll();
+            return $"База: {c.Count} авто";
+        }
+    }
+
+    // ── Upgrades ──────────────────────────────────────────────────────────────
+
+    public static UpgradeTableData GetUpgrades()
+    {
+        if (_upgrades != null) return _upgrades;
+        lock (_lock) { _upgrades ??= LoadUpgrades(); }
+        return _upgrades;
+    }
+
+    // ── Online refresh ────────────────────────────────────────────────────────
+
+    public static async Task<string> RefreshFromUrlAsync(string carsUrl, string upgradesUrl)
+    {
+        using var http = new System.Net.Http.HttpClient();
+        http.Timeout = TimeSpan.FromSeconds(30);
+
+        var carsJson     = await http.GetStringAsync(carsUrl);
+        var upgradesJson = await http.GetStringAsync(upgradesUrl);
+
+        var dataDir = AppDataDir();
+        Directory.CreateDirectory(dataDir);
+
+        await File.WriteAllTextAsync(Path.Combine(dataDir, "fh6_cars.json"),    carsJson);
+        await File.WriteAllTextAsync(Path.Combine(dataDir, "upgrade_pi_table.json"), upgradesJson);
+
+        lock (_lock) { _cars = null; _upgrades = null; }
+        return $"Загружено {GetAll().Count} авто";
+    }
+
+    // ── Private ───────────────────────────────────────────────────────────────
+
+    private static List<CarEntry> LoadCars()
+    {
+        var json = ReadJson("fh6_cars.json");
+        return JsonSerializer.Deserialize<List<CarEntry>>(json, _jsonOpts) ?? [];
+    }
+
+    private static UpgradeTableData LoadUpgrades()
+    {
+        var json = ReadJson("upgrade_pi_table.json");
+        return JsonSerializer.Deserialize<UpgradeTableData>(json, _jsonOpts) ?? new();
+    }
+
+    private static string ReadJson(string fileName)
+    {
+        // 1. AppData override
+        var appPath = Path.Combine(AppDataDir(), fileName);
+        if (File.Exists(appPath))
+            return File.ReadAllText(appPath);
+
+        // 2. Embedded resource fallback
+        var asm = Assembly.GetExecutingAssembly();
+        var resourceName = asm.GetManifestResourceNames()
+            .FirstOrDefault(n => n.EndsWith(fileName, StringComparison.OrdinalIgnoreCase));
+        if (resourceName != null)
+        {
+            using var stream = asm.GetManifestResourceStream(resourceName)!;
+            using var reader = new StreamReader(stream);
+            return reader.ReadToEnd();
+        }
+
+        throw new FileNotFoundException($"Data file not found: {fileName}");
+    }
+
+    private static string AppDataDir() =>
+        Path.Combine(
+            Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData),
+            "ForzaTuneMaster", "data");
+}
