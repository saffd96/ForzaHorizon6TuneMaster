+using Forza_Horizon_6_Tune_Master.Data;
+using Forza_Horizon_6_Tune_Master.Models;
+
+namespace Forza_Horizon_6_Tune_Master.Services;
+
+// ── Result types ─────────────────────────────────────────────────────────────
+
+public class BuildPlanResult
+{
+    public CarEntry Car              { get; init; } = null!;
+    public int      TargetPI         { get; init; }
+    public string   TargetClass      { get; init; } = "";
+    public int      AchievedPI       { get; set; }
+    public string   AchievedClass    { get; set; } = "";
+    public int      TotalPIImpact    => AchievedPI - Car.StockPI;
+    public int      TotalPIAbsolute  => Math.Abs(TotalPIImpact);
+    public string   TotalPISignLabel => TotalPIImpact >= 0 ? "+" : "−";
+    public List<UpgradeStep> Steps   { get; } = [];
+
+    // Exactly one mode flag is true
+    public bool IsUpgrade        { get; init; }  // stock PI < targetMin
+    public bool IsInClassUpgrade { get; init; }  // stock PI already in class → maximise within it
+    public bool IsDowngrade      { get; init; }  // stock PI > targetMax → not supported
+
+    // Outcome
+    public bool AlreadyMaxed      { get; set; }  // no room to improve
+    public bool TargetUnreachable { get; set; }  // couldn't close the gap
+}
+
+public class UpgradeStep
+{
+    public string CategoryKey      { get; init; } = "";
+    public string CategoryLabel    { get; init; } = "";
+    public string CurrentTier      { get; init; } = "Stock";
+    public string RecommendedTier  { get; init; } = "";
+    public string RecommendedLabel { get; init; } = "";
+    public int    PIImpact         { get; init; }
+    public int    PIAbsolute       => Math.Abs(PIImpact);
+    public string PISign           => PIImpact >= 0 ? "+" : "−";
+    public bool   IsNegative       => PIImpact < 0;
+    public float  PowerMul         { get; init; } = 1f;
+    public float  MassMul          { get; init; } = 1f;
+    public string Note             { get; init; } = "";
+}
+
+// ── Service ───────────────────────────────────────────────────────────────────
+
+public class BuildPlannerService
+{
+    private static readonly Dictionary<CarClass, (int Min, int Max)> ClassBounds = new()
+    {
+        { CarClass.D,  (100, 299)  },
+        { CarClass.C,  (300, 499)  },
+        { CarClass.B,  (500, 599)  },
+        { CarClass.A,  (600, 699)  },
+        { CarClass.S1, (700, 799)  },
+        { CarClass.S2, (800, 899)  },
+        { CarClass.R,  (900, 998)  },
+        { CarClass.X,  (999, 9999) },
+    };
+
+    public static CarClass ClassOf(int pi) => pi switch
+    {
+        < 300 => CarClass.D, < 500 => CarClass.C, < 600 => CarClass.B,
+        < 700 => CarClass.A, < 800 => CarClass.S1, < 900 => CarClass.S2,
+        < 999 => CarClass.R, _ => CarClass.X
+    };
+
+    public BuildPlanResult RecommendUpgrades(CarEntry car, CarClass targetClass, Discipline discipline)
+    {
+        var (targetMin, targetMax) = ClassBounds[targetClass];
+
+        // Downgrade — not supported in FH6 (no ballast/restrictor)
+        if (car.StockPI > targetMax)
+            return new BuildPlanResult
+            {
+                Car = car, TargetPI = targetMax, TargetClass = targetClass.ToString(),
+                AchievedPI = car.StockPI, AchievedClass = ClassOf(car.StockPI).ToString(),
+                IsDowngrade = true
+            };
+
+        // Already in class → show all possible in-class improvements
+        if (car.StockPI >= targetMin)
+            return RunInClassUpgrade(car, targetClass, targetMin, targetMax, discipline);
+
+        // Below class → standard upgrade path
+        return RunUpgrade(car, targetClass, targetMin, targetMax, discipline);
+    }
+
+    // ══════════════════════════════════════════════════════════════════════════
+    // UPGRADE  (stock PI < targetMin)
+    // ══════════════════════════════════════════════════════════════════════════
+    private static BuildPlanResult RunUpgrade(CarEntry car, CarClass targetClass,
+        int targetMin, int targetMax, Discipline discipline)
+    {
+        var result = new BuildPlanResult
+        {
+            Car = car, TargetPI = targetMin,
+            TargetClass = targetClass.ToString(), IsUpgrade = true
+        };
+
+        RunGreedy(car, result, car.StockPI, targetMin, targetMax, discipline,
+                  stopAtMin: true, out int achieved);
+
+        result.AchievedPI    = achieved;
+        result.AchievedClass = ClassOf(achieved).ToString();
+        return result;
+    }
+
+    // ══════════════════════════════════════════════════════════════════════════
+    // IN-CLASS UPGRADE  (already in class → fill up to targetMax)
+    // ══════════════════════════════════════════════════════════════════════════
+    private static BuildPlanResult RunInClassUpgrade(CarEntry car, CarClass targetClass,
+        int targetMin, int targetMax, Discipline discipline)
+    {
+        var result = new BuildPlanResult
+        {
+            Car = car, TargetPI = targetMax,
+            TargetClass = targetClass.ToString(), IsInClassUpgrade = true
+        };
+
+        if (car.StockPI >= targetMax)
+        {
+            result.AlreadyMaxed  = true;
+            result.AchievedPI    = car.StockPI;
+            result.AchievedClass = targetClass.ToString();
+            return result;
+        }
+
+        RunGreedy(car, result, car.StockPI, targetMax, targetMax, discipline,
+                  stopAtMin: false, out int achieved);
+
+        if (result.Steps.Count == 0) result.AlreadyMaxed = true;
+
+        result.AchievedPI    = achieved;
+        result.AchievedClass = ClassOf(achieved).ToString();
+        return result;
+    }
+
+    // ── Core greedy ───────────────────────────────────────────────────────────
+    // Iterates categories in discipline priority order; picks the single best
+    // tier per category that fits within targetMax.
+    // stopAtMin=true  → stop outer loop once currentPI ≥ targetMin  (upgrade mode)
+    // stopAtMin=false → run all categories, try to reach targetMax   (in-class mode)
+    private static void RunGreedy(CarEntry car, BuildPlanResult result,
+        int startPI, int targetMin, int targetMax, Discipline discipline,
+        bool stopAtMin, out int currentPI)
+    {
+        currentPI = startPI;
+
+        var table       = CarDatabase.GetUpgrades();
+        var catsByKey   = table.Categories.ToDictionary(c => c.Key, c => c);
+        var appliedKeys = new HashSet<string>();
+
+        var (priority, allowedTiers) = GetDisciplineProfile(discipline);
+
+        // Pass 1 — greedy by discipline priority
+        foreach (var catKey in priority)
+        {
+            if (stopAtMin && currentPI >= targetMin) break;
+
+            if (!catsByKey.TryGetValue(catKey, out var cat)) continue;
+            if (cat.ConflictsWith.Any(appliedKeys.Contains)) continue;
+            if (car.PowertrainType == "Electric" && catKey is "engine" or "induction" or "intake") continue;
+            if (catKey == "induction" && car.AspirationType is "SingleTurbo" or "TwinTurbo") continue;
+
+            var allowed  = allowedTiers.TryGetValue(catKey, out var r) ? r : null;
+            var bestTier = PickBestTier(cat, allowed, currentPI, targetMax);
+            if (bestTier == null) continue;
+
+            AddStep(result, cat, bestTier, "Stock", discipline);
+            currentPI += bestTier.PiCost;
+            appliedKeys.Add(catKey);
+        }
+
+        // Pass 2 — fallback: find cheapest single tier landing us inside [targetMin, targetMax]
+        if (stopAtMin && currentPI < targetMin)
+        {
+            var (fbCat, fbTier) = FindFallback(table, appliedKeys, car, currentPI, targetMin, targetMax);
+            if (fbTier != null && fbCat != null)
+            {
+                AddStep(result, fbCat, fbTier, "Stock", discipline, "Необходим для достижения класса");
+                currentPI += fbTier.PiCost;
+            }
+            else
+            {
+                result.TargetUnreachable = true;
+            }
+        }
+    }
+
+    // ── Helpers ───────────────────────────────────────────────────────────────
+
+    private static UpgradeTierDef? PickBestTier(UpgradeCategory cat,
+        HashSet<string>? allowed, int currentPI, int targetMax)
+    {
+        UpgradeTierDef? best = null;
+        foreach (var tier in cat.Tiers)
+        {
+            if (tier.PiCost <= 0) continue;
+            if (allowed != null && !allowed.Contains(tier.Key)) continue;
+            if (currentPI + tier.PiCost > targetMax) break;
+            best = tier;
+        }
+        return best;
+    }
+
+    private static (UpgradeCategory?, UpgradeTierDef?) FindFallback(
+        UpgradeTableData table, HashSet<string> appliedKeys,
+        CarEntry car, int currentPI, int targetMin, int targetMax)
+    {
+        UpgradeTierDef? bestTier = null;
+        UpgradeCategory? bestCat = null;
+        int bestOvershoot = int.MaxValue;
+
+        foreach (var cat in table.Categories)
+        {
+            if (appliedKeys.Contains(cat.Key)) continue;
+            if (cat.ConflictsWith.Any(appliedKeys.Contains)) continue;
+            if (car.PowertrainType == "Electric" && cat.Key is "engine" or "induction" or "intake") continue;
+
+            foreach (var tier in cat.Tiers)
+            {
+                if (tier.PiCost <= 0) continue;
+                int newPI = currentPI + tier.PiCost;
+                if (newPI < targetMin || newPI > targetMax) continue;
+                int overshoot = newPI - targetMin;
+                if (overshoot < bestOvershoot)
+                { bestOvershoot = overshoot; bestTier = tier; bestCat = cat; }
+            }
+        }
+        return (bestCat, bestTier);
+    }
+
+    private static void AddStep(BuildPlanResult result, UpgradeCategory cat,
+        UpgradeTierDef tier, string currentTier, Discipline discipline, string note = "")
+    {
+        result.Steps.Add(new UpgradeStep
+        {
+            CategoryKey      = cat.Key,
+            CategoryLabel    = cat.Label,
+            CurrentTier      = currentTier,
+            RecommendedTier  = tier.Key,
+            RecommendedLabel = tier.Label,
+            PIImpact         = tier.PiCost,
+            PowerMul         = tier.PowerMul,
+            MassMul          = tier.MassMul,
+            Note             = note.Length > 0 ? note : BuildNote(cat.Key, tier.Key, discipline)
+        });
+    }
+
+    // ── Discipline profiles ───────────────────────────────────────────────────
+
+    private static (List<string> Priority, Dictionary<string, HashSet<string>> AllowedTiers)
+        GetDisciplineProfile(Discipline discipline)
+    {
+        var allowed = new Dictionary<string, HashSet<string>>();
+
+        List<string> priority = discipline switch
+        {
+            Discipline.Road or Discipline.Street or Discipline.Eliminator =>
+                ["tires", "weight", "engine", "induction", "intake", "suspension", "differential", "brakes", "aero", "transmission"],
+            Discipline.Touge =>
+                ["suspension", "tires", "engine", "differential", "brakes", "weight", "transmission"],
+            Discipline.Rally or Discipline.CrossCountry =>
+                ["tires", "suspension", "weight", "engine", "differential", "brakes"],
+            Discipline.Drift =>
+                ["differential", "suspension", "weight", "tires", "brakes", "engine"],
+            Discipline.Drag =>
+                ["engine", "induction", "intake", "tires", "differential", "weight", "brakes", "transmission"],
+            _ => ["tires", "weight", "engine", "suspension", "differential", "brakes", "aero"]
+        };
+
+        switch (discipline)
+        {
+            case Discipline.Rally:
+            case Discipline.CrossCountry:
+                allowed["tires"]      = ["Rally", "Offroad"];
+                allowed["suspension"] = ["Rally"];
+                break;
+            case Discipline.Drift:
+                allowed["tires"]        = ["Street", "Sport"];
+                allowed["suspension"]   = ["Drift", "Sport"];
+                allowed["differential"] = ["DriftSpec", "Race"];
+                break;
+            case Discipline.Drag:
+                allowed["tires"]      = ["Drag"];
+                allowed["suspension"] = ["Street", "Sport"];
+                break;
+            case Discipline.Touge:
+                allowed["tires"] = ["Street", "Sport", "SemiSlick"];
+                break;
+        }
+        return (priority, allowed);
+    }
+
+    private static string BuildNote(string catKey, string tierKey, Discipline discipline) =>
+        (catKey, discipline) switch
+        {
+            ("tires",        Discipline.Rally)       => "Rally-шины для грунта и грязи",
+            ("tires",        Discipline.CrossCountry) => "Offroad-шины для бездорожья",
+            ("tires",        Discipline.Drift)        => "Мягкая резина для управляемого заноса",
+            ("tires",        Discipline.Drag)         => "Drag-шины для максимального сцепления",
+            ("suspension",   Discipline.Rally)        => "Rally-подвеска для прыжков и грунта",
+            ("suspension",   Discipline.Drift)        => "Drift-подвеска для точного угла заноса",
+            ("differential", Discipline.Drift)        => "Drift Spec для стабильного заноса",
+            ("differential", Discipline.Drag)         => "Блокировка для равномерного старта",
+            ("engine",       Discipline.Drag)         => "Мощность — главный приоритет Drag",
+            ("induction",    Discipline.Drag)         => "Наддув для максимального прироста",
+            _ when catKey == "engine" && tierKey.EndsWith("Swap") => "Свап двигателя",
+            _ => ""
+        };
+}
