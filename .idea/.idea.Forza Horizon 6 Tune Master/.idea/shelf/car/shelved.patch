<+><Window x:Class=\"Forza_Horizon_6_Tune_Master.MainWindow\"\r\n        xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\r\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\r\n        xmlns:views=\"clr-namespace:Forza_Horizon_6_Tune_Master.Views\"\r\n        xmlns:cv=\"clr-namespace:Forza_Horizon_6_Tune_Master.Converters\"\r\n        Title=\"Forza Horizon 6 Tune Master\"\r\n        Width=\"1400\" Height=\"860\"\r\n        MinWidth=\"1100\" MinHeight=\"620\"\r\n        WindowStartupLocation=\"CenterScreen\"\r\n        Background=\"{StaticResource BgBrush}\">\r\n    <Window.Icon>\r\n        <BitmapImage UriSource=\"pack://application:,,,/icon.ico\"/>\r\n    </Window.Icon>\r\n\r\n    <Window.Resources>\r\n        <cv:EqualityConverter x:Key=\"Eq\"/>\r\n        <cv:EqualityVisibilityConverter x:Key=\"EqVis\"/>\r\n        <cv:InverseBoolToVisibilityConverter x:Key=\"BoolToCollapsed\"/>\r\n    </Window.Resources>\r\n\r\n    <Grid ClipToBounds=\"True\">\r\n        <Grid.RowDefinitions>\r\n            <RowDefinition Height=\"Auto\"/>  <!-- Title bar —  2-row, auto-sizes to content -->\r\n            <RowDefinition Height=\"*\"/>    <!-- Main content -->\r\n            <RowDefinition Height=\"28\"/>   <!-- Status bar -->\r\n        </Grid.RowDefinitions>\r\n\r\n        <!-- ══ Title Bar ════════════════════════════════════════════════ -->\r\n        <!-- 2-row layout: row 0 = logo + profiles, row 1 = unit toggles.\r\n             Fixes overflow at MinWidth=1100 where single-row approach squeezed\r\n             profiles into <480px (needs ~580px). -->\r\n        <Border Grid.Row=\"0\"\r\n                Background=\"{StaticResource SurfaceBrush}\"\r\n                BorderBrush=\"{StaticResource BorderBrush}\"\r\n                BorderThickness=\"0,0,0,1\">\r\n            <Grid>\r\n                <Grid.RowDefinitions>\r\n                    <RowDefinition Height=\"50\"/>\r\n                    <RowDefinition Height=\"Auto\"/>\r\n                </Grid.RowDefinitions>\r\n\r\n                <!-- Row 0: Logo | Profile management | Version -->\r\n                <Grid Grid.Row=\"0\" Margin=\"20,0\">\r\n                    <Grid.ColumnDefinitions>\r\n                        <ColumnDefinition Width=\"Auto\"/>\r\n                        <ColumnDefinition Width=\"*\"/>\r\n                        <ColumnDefinition Width=\"Auto\"/>\r\n                    </Grid.ColumnDefinitions>\r\n\r\n                    <!-- Logo + Title -->\r\n                    <StackPanel Grid.Column=\"0\" Orientation=\"Horizontal\" VerticalAlignment=\"Center\">\r\n                        <Viewbox Width=\"32\" Height=\"32\" Margin=\"0,0,12,0\">\r\n                            <Canvas Width=\"32\" Height=\"32\">\r\n                                <Rectangle Width=\"32\" Height=\"32\" Fill=\"#0C0E16\" RadiusX=\"6\" RadiusY=\"6\"/>\r\n                                <Ellipse Canvas.Left=\"11\" Canvas.Top=\"1.5\" Width=\"10\" Height=\"10\" Fill=\"#1ABCFE\" Opacity=\"0.9\"/>\r\n                                <Rectangle Canvas.Left=\"3\"  Canvas.Top=\"10\"  Width=\"26\" Height=\"3.5\" Fill=\"#FF5E0E\" RadiusX=\"1\" RadiusY=\"1\"/>\r\n                                <Rectangle Canvas.Left=\"6.5\" Canvas.Top=\"16\" Width=\"19\" Height=\"2.5\" Fill=\"#FF5E0E\"/>\r\n                                <Rectangle Canvas.Left=\"7.5\" Canvas.Top=\"10\" Width=\"4\"  Height=\"20\" Fill=\"#FF5E0E\"/>\r\n                                <Rectangle Canvas.Left=\"20.5\" Canvas.Top=\"10\" Width=\"4\"  Height=\"20\" Fill=\"#FF5E0E\"/>\r\n                            </Canvas>\r\n                        </Viewbox>\r\n                        <StackPanel VerticalAlignment=\"Center\">\r\n                            <TextBlock Text=\"FORZA HORIZON 6\" Style=\"{StaticResource SubtitleText}\"/>\r\n                            <TextBlock Text=\"TUNE MASTER\" FontSize=\"{DynamicResource FontHeading}\" FontWeight=\"Bold\"\r\n                                       Foreground=\"{StaticResource TextBrush}\" Margin=\"0,-2,0,0\"/>\r\n                        </StackPanel>\r\n                    </StackPanel>\r\n\r\n                    <!-- Profile Management — centered, now has full * column (~810px at min width) -->\r\n                    <StackPanel Grid.Column=\"1\" Orientation=\"Horizontal\"\r\n                                HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\">\r\n                        <TextBlock Text=\"Профили:\" Foreground=\"{StaticResource TextDimBrush}\"\r\n                                   VerticalAlignment=\"Center\" Margin=\"0,0,8,0\" FontSize=\"12\"/>\r\n                        <ComboBox ItemsSource=\"{Binding Profiles}\"\r\n                                  SelectedItem=\"{Binding SelectedProfile}\"\r\n                                  MinWidth=\"140\"\r\n                                  Background=\"{StaticResource ElevatedBrush}\"\r\n                                  BorderBrush=\"{StaticResource BorderBrush}\"\r\n                                  VerticalAlignment=\"Center\"/>\r\n                        <Button Content=\"\uD83D\uDCBE Сохранить\" Style=\"{StaticResource SecondaryButton}\"\r\n                                Command=\"{Binding SaveCommand}\" Margin=\"6,0,0,0\" Padding=\"10,5\"/>\r\n                        <Button Content=\"Загрузить\"    Style=\"{StaticResource SecondaryButton}\"\r\n                                Command=\"{Binding LoadCommand}\" Margin=\"4,0,0,0\" Padding=\"10,5\"/>\r\n                        <Button Content=\"\uD83D\uDDD1 Удалить\"   Style=\"{StaticResource DangerButton}\"\r\n                                Command=\"{Binding DeleteProfileCommand}\" Margin=\"4,0,0,0\" Padding=\"10,5\"/>\r\n                        <Button Content=\"+ Новый\"      Style=\"{StaticResource SecondaryButton}\"\r\n                                Command=\"{Binding NewProfileCommand}\" Margin=\"4,0,0,0\" Padding=\"10,5\"/>\r\n                    </StackPanel>\r\n\r\n                    <!-- Version tag -->\r\n                    <TextBlock Grid.Column=\"2\" Text=\"MVP v1.0\"\r\n                               Foreground=\"{StaticResource TextMutedBrush}\"\r\n                               FontSize=\"{DynamicResource FontXSmall}\" VerticalAlignment=\"Center\"/>\r\n                </Grid>\r\n\r\n                <!-- Row 1: Unit toggles sub-bar -->\r\n                <Border Grid.Row=\"1\"\r\n                        BorderBrush=\"{StaticResource BorderBrush}\"\r\n                        BorderThickness=\"0,1,0,0\"\r\n                        Padding=\"20,4\">\r\n                    <StackPanel Orientation=\"Horizontal\" VerticalAlignment=\"Center\">\r\n                        <TextBlock Text=\"Единицы:\" Foreground=\"{StaticResource TextMutedBrush}\"\r\n                                   FontSize=\"{DynamicResource FontXSmall}\" VerticalAlignment=\"Center\" Margin=\"0,0,10,0\"/>\r\n                        <ComboBox ItemsSource=\"{Binding UnitSystemOptions}\"\r\n                                  SelectedItem=\"{Binding SelectedUnitSystemItem}\"\r\n                                  MinWidth=\"120\" Margin=\"0,0,4,0\"\r\n                                  ToolTip=\"Метрическая / Имперская система мер\"/>\r\n                        <ComboBox ItemsSource=\"{Binding PowerUnitOptions}\"\r\n                                  SelectedItem=\"{Binding SelectedPowerUnitItem}\"\r\n                                  MinWidth=\"70\" Margin=\"0,0,4,0\"\r\n                                  ToolTip=\"л.с. / PS / кВт\"/>\r\n                        <ComboBox ItemsSource=\"{Binding SpringUnitOptions}\"\r\n                                  SelectedItem=\"{Binding SelectedSpringUnitItem}\"\r\n                                  MinWidth=\"100\"\r\n                                  ToolTip=\"кгс/мм / Н/мм / фунт/дюйм\"/>\r\n                        <Button Content=\"?\"\r\n                                Style=\"{StaticResource SecondaryButton}\"\r\n                                Padding=\"10,3\" Margin=\"10,0,0,0\"\r\n                                FontWeight=\"Bold\" FontSize=\"{DynamicResource FontNormal}\"\r\n                                ToolTip=\"Как пользоваться Tune Master\"\r\n                                Click=\"HelpButton_Click\"/>\r\n                    </StackPanel>\r\n                </Border>\r\n            </Grid>\r\n        </Border>\r\n\r\n        <!-- ══ Main Content ═════════════════════════════════════════════ -->\r\n        <Grid Grid.Row=\"1\" ClipToBounds=\"True\">\r\n            <Grid.ColumnDefinitions>\r\n                <ColumnDefinition Width=\"2*\"/>\r\n                <ColumnDefinition Width=\"*\"/>\r\n            </Grid.ColumnDefinitions>\r\n\r\n            <!-- ════════ LEFT PANEL (2/3) ════════════════════════════ -->\r\n            <Grid Grid.Column=\"0\" Margin=\"0,0,1,0\" ClipToBounds=\"True\">\r\n                <Grid.RowDefinitions>\r\n                    <RowDefinition Height=\"*\"/>       <!-- Content -->\r\n                    <RowDefinition Height=\"Auto\"/>    <!-- Bottom bar -->\r\n                </Grid.RowDefinitions>\r\n\r\n                <!-- Content area: Car -->\r\n                <views:CarCardView Grid.Row=\"0\"\r\n                    DataContext=\"{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}\"/>\r\n\r\n                <!-- Bottom bar: discipline + generate + auto -->\r\n                <Border Grid.Row=\"1\"\r\n                        Background=\"{StaticResource SurfaceBrush}\"\r\n                        BorderBrush=\"{StaticResource BorderBrush}\"\r\n                        BorderThickness=\"0,1,0,0\"\r\n                        Padding=\"12,8\">\r\n                    <Grid>\r\n                        <Grid.ColumnDefinitions>\r\n                            <ColumnDefinition Width=\"*\"/>\r\n                            <ColumnDefinition Width=\"Auto\"/>\r\n                        </Grid.ColumnDefinitions>\r\n\r\n                        <!-- Discipline selector -->\r\n                        <views:TrackInfoView Grid.Column=\"0\"/>\r\n\r\n                        <!-- Generate button (hidden when auto-generate is on) -->\r\n                        <Button Grid.Column=\"1\"\r\n                                Content=\"⚡  Сгенерировать\"\r\n                                Style=\"{StaticResource PrimaryButton}\"\r\n                                Command=\"{Binding GenerateCommand}\"\r\n                                FontSize=\"{DynamicResource FontNormal}\" Padding=\"20,8\"\r\n                                Visibility=\"{Binding IsAutoGenerate, Converter={StaticResource BoolToCollapsed}}\"/>\r\n                    </Grid>\r\n                </Border>\r\n            </Grid>\r\n\r\n            <!-- ════════ RIGHT PANEL (1/3) ═══════════════════════════ -->\r\n            <Border Grid.Column=\"1\"\r\n                    Background=\"{StaticResource BgBrush}\"\r\n                    BorderBrush=\"{StaticResource BorderBrush}\"\r\n                    BorderThickness=\"1,0,0,0\">\r\n                <views:TuneResultView DataContext=\"{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}\"/>\r\n            </Border>\r\n        </Grid>\r\n\r\n        <!-- ══ Status Bar ══════════════════════════════════════════════ -->\r\n        <Border Grid.Row=\"2\"\r\n                Background=\"{StaticResource SurfaceBrush}\"\r\n                BorderBrush=\"{StaticResource BorderBrush}\"\r\n                BorderThickness=\"0,1,0,0\">\r\n            <TextBlock Text=\"{Binding StatusMessage, TargetNullValue='Готов'}\"\r\n                       Foreground=\"{StaticResource TextDimBrush}\"\r\n                       FontSize=\"{DynamicResource FontXSmall}\" VerticalAlignment=\"Center\"\r\n                       Margin=\"16,0\"/>\r\n        </Border>\r\n\r\n    </Grid>\r\n</Window>\r\n
