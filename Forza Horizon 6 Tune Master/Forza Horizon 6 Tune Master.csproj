<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <RootNamespace>Forza_Horizon_6_Tune_Master</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <Deterministic>false</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" Version="8.0.5" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.5" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Assets\dalink-qr-code.png" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="icon.ico" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\en.json" LogicalName="Forza_Horizon_6_Tune_Master.Localization.en.json" />
        <EmbeddedResource Include="Localization\ru.json" LogicalName="Forza_Horizon_6_Tune_Master.Localization.ru.json" />
        <EmbeddedResource Include="Localization\GameStrings.en.json" LogicalName="Forza_Horizon_6_Tune_Master.Localization.GameStrings.en.json" WithCulture="false" />
        <EmbeddedResource Include="Localization\GameStrings.ru.json" LogicalName="Forza_Horizon_6_Tune_Master.Localization.GameStrings.ru.json" WithCulture="false" />
        <EmbeddedResource Include="..\DUMPER\fh6_db.sqlite" LogicalName="DUMPER.fh6_db.sqlite" />
    </ItemGroup>

</Project>
