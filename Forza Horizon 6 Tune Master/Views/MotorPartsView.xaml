<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.MotorPartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Forza_Horizon_6_Tune_Master.Views"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services">
    <StackPanel>
        <TextBlock Text="{l:Loc SectionMotor}" Style="{StaticResource PartGroupHeader}" Margin="0,0,0,4"/>
        <v:PartRow Label="{l:Loc Part_Motor}"      Options="{Binding MotorSwaps}" Selected="{Binding SelectedMotorSwap}"/>
        <v:PartRow Label="{l:Loc Part_MotorParts}" Options="{Binding MotorParts}" Selected="{Binding SelectedMotorPart}"/>
        <TextBlock Text="{Binding MotorInfo}"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="{DynamicResource FontXSmall}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,2"
                   Visibility="{Binding MotorInfo, Converter={StaticResource NullVis}}"/>
    </StackPanel>
</UserControl>
