<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.MotorPartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services">
    <StackPanel>
        <TextBlock Text="{l:Loc SectionMotor}" Style="{StaticResource SectionHeader}"/>
        <UniformGrid Columns="6" HorizontalAlignment="Stretch" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding MotorSwaps}" SelectedItem="{Binding SelectedMotorSwap}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding MotorSwaps.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding MotorParts}" SelectedItem="{Binding SelectedMotorPart}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding MotorParts.Count, Converter={StaticResource CountVis}}"/>
        </UniformGrid>
        <TextBlock Text="{Binding MotorInfo}"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="{DynamicResource FontXSmall}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   Visibility="{Binding MotorInfo, Converter={StaticResource NullVis}}"/>
    </StackPanel>
</UserControl>
