<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.CarCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
             xmlns:m="clr-namespace:Forza_Horizon_6_Tune_Master.Models"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <cv:AspirationTypeLabelConverter      x:Key="AspLabel"/>
        <cv:PowertrainTypeLabelConverter      x:Key="PtLabel"/>
        <cv:BoolToVisibilityConverter         x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter  x:Key="BoolToCollapsed"/>
        <cv:EnumToBoolConverter               x:Key="E2B"/>
        <cv:InverseBoolConverter              x:Key="InvBool"/>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,24">

            <!-- ── Car Selection ─────────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                <TextBlock Text="ВЫБОР АВТОМОБИЛЯ"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="{DynamicResource FontMicro}"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <Button Command="{Binding RefreshCarDatabaseCommand}"
                        Style="{StaticResource IconButton}"
                        Width="24" Height="24"
                        Margin="6,0,0,0"
                        ToolTip="Обновить базу автомобилей с сайта">
                    <TextBlock Text="↻" FontSize="16" Margin="0,-4,0,0"/>
                </Button>
                <Button Command="{Binding ClearCacheCommand}"
                        Style="{StaticResource IconButton}"
                        Width="24" Height="24"
                        Margin="4,0,0,0"
                        ToolTip="Очистить кеш базы и характеристик (потребует повторной загрузки)">
                    <TextBlock Text="🗑" FontSize="13" Margin="0,-1,0,0"/>
                </Button>
            </StackPanel>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="CarSearchBox"
                                 Text="{Binding CarSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Начните вводить марку, модель или год..."
                                 GotFocus="CarSearchBox_GotFocus"
                                 LostFocus="CarSearchBox_LostFocus" />
                        <Button Grid.Column="1" Content="✕"
                                Command="{Binding ClearCarSelectionCommand}"
                                Style="{StaticResource IconButton}"
                                Width="30" Height="30"
                                Margin="6,0,0,0"
                                Click="ClearButton_Click"
                                ToolTip="Очистить выбор"/>
                    </Grid>
                    <ListBox x:Name="CarListBox"
                             ItemsSource="{Binding FilteredCarDatabase}"
                             DisplayMemberPath="DisplayName"
                             SelectedItem="{Binding SelectedCar}"
                             MaxHeight="180"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="CarListBox_SelectionChanged"
                             Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ── Mass ─────────────────────────────────────────────────── -->
            <TextBlock Text="МАССА И РАЗВЕСОВКА" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding MassFieldLabel}"    Style="{StaticResource FormLabel}" Width="170"/>
                    <TextBox   Grid.Column="1" Text="{Binding MassDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBlock Grid.Column="3" Text="Развесовка перед (%)" Style="{StaticResource FormLabel}" Width="180"/>
                    <TextBox   Grid.Column="4" Text="{Binding Car.WeightDistributionFront, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

            <!-- ── Engine ───────────────────────────────────────────────── -->
            <TextBlock Text="ДВИГАТЕЛЬ" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Тип силовой установки" Style="{StaticResource FormLabel}" Width="200"/>
                        <ComboBox  x:Name="PowertrainTypeCombo" Grid.Column="1"
                                   SelectedValue="{Binding Car.PowertrainType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PtLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PowerFieldLabel}" Style="{StaticResource FormLabel}" MinWidth="100"/>
                        <TextBox   Grid.Column="1" Text="{Binding PowerDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="3" Text="{Binding TorqueFieldLabel}"     Style="{StaticResource FormLabel}" MinWidth="80"/>
                        <TextBox   Grid.Column="4" Text="{Binding TorqueDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="6" Text="{Binding MaxRPMFieldLabel}" Style="{StaticResource FormLabel}" MinWidth="80"/>
                        <TextBox   Grid.Column="7" Text="{Binding Car.MaxRPM,   UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding Car.IsElectricPowertrain, Converter={StaticResource BoolToCollapsed}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Тип двигателя" Style="{StaticResource FormLabel}" Width="150"/>
                        <ComboBox  x:Name="EngineTypeCombo" Grid.Column="1"
                                   SelectedValue="{Binding Car.EngineType}"/>
                        <TextBlock Grid.Column="3" Text="Расположение" Style="{StaticResource FormLabel}" Width="130"/>
                        <ComboBox  x:Name="EnginePositionCombo" Grid.Column="4" Width="160"
                                   HorizontalAlignment="Left"
                                   SelectedValue="{Binding Car.EnginePosition}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding Car.IsElectricPowertrain, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Text="Тип топлива" Style="{StaticResource FormLabel}" Width="150"/>
                        <RadioButton Content="Бензин / Газ" Margin="0,0,16,0"
                                     GroupName="FuelType"
                                     IsChecked="{Binding Car.FuelType, Converter={StaticResource E2B},
                                                 ConverterParameter={x:Static m:FuelType.Gasoline}}"/>
                        <RadioButton Content="Дизель"
                                     GroupName="FuelType"
                                     IsChecked="{Binding Car.FuelType, Converter={StaticResource E2B},
                                                 ConverterParameter={x:Static m:FuelType.Diesel}}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding Car.ShowAspiration, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Наддув" Style="{StaticResource FormLabel}" Width="150"/>
                        <ComboBox  x:Name="AspirationCombo" Grid.Column="1"
                                   SelectedItem="{Binding Car.AspirationType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource AspLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <CheckBox Content="Антилаг"
                              IsChecked="{Binding Car.AntiLag}"
                              Visibility="{Binding Car.ShowAntiLag, Converter={StaticResource BoolVis}}"
                              Margin="150,0,0,8"/>
                    <!-- Computed RPM display -->
                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="5" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Пик мощности (расч.):"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Car.PowerPeakRPM, StringFormat='{}{0} об/мин'}"
                                       Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Пик момента (расч.):"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="24,0,8,0"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Car.TorquePeakRPM, StringFormat='{}{0} об/мин'}"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Transmission ─────────────────────────────────────────── -->
            <TextBlock Text="ТРАНСМИССИЯ" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Тип привода"  Style="{StaticResource FormLabel}" Width="130"/>
                        <ComboBox  x:Name="DriveTypeCombo" Grid.Column="1"
                                   SelectedValue="{Binding Car.DriveType}"/>
                        <TextBlock Grid.Column="3" Text="Кол-во передач" Style="{StaticResource FormLabel}" Width="130"/>
                        <TextBox   Grid.Column="4" Text="{Binding Car.GearCount, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <CheckBox Content="Рассчитывать передаточный ряд"
                                  IsChecked="{Binding Car.AllowGearCalculation}"
                                  Margin="0,0,20,0"/>
                        <CheckBox Content="Только главная передача"
                                  IsChecked="{Binding Car.OnlyFinalDriveCalculation}"
                                  Visibility="{Binding Car.AllowGearCalculation, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Tires ────────────────────────────────────────────────── -->
            <TextBlock Text="ШИНЫ И КОЛЁСА" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Шина ПЕРЕД — ширина" Style="{StaticResource FormLabel}" Width="175"/>
                        <TextBox   Grid.Column="1" Text="{Binding Car.FrontTireWidth,   UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="3" Text="Профиль"  Style="{StaticResource FormLabel}" Width="70"/>
                        <TextBox   Grid.Column="4" Text="{Binding Car.FrontTireProfile, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="6" Text="Диск (дюйм)"  Style="{StaticResource FormLabel}" Width="95"/>
                        <TextBox   Grid.Column="7" Text="{Binding Car.FrontRimDiameter, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Шина ЗАД — ширина"   Style="{StaticResource FormLabel}" Width="175"/>
                        <TextBox   Grid.Column="1" Text="{Binding Car.RearTireWidth,    UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="3" Text="Профиль"  Style="{StaticResource FormLabel}" Width="70"/>
                        <TextBox   Grid.Column="4" Text="{Binding Car.RearTireProfile,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="6" Text="Диск (дюйм)"  Style="{StaticResource FormLabel}" Width="95"/>
                        <TextBox   Grid.Column="7" Text="{Binding Car.RearRimDiameter,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Тип шин" Style="{StaticResource FormLabel}" Width="130"/>
                        <ComboBox  x:Name="TireTypeCombo" Width="200"
                                   SelectedValue="{Binding Car.TireType}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Car specs ─────────────────────────────────────────────── -->
            <TextBlock Text="ХАРАКТЕРИСТИКИ" Style="{StaticResource SectionHeader}"/>
            <Button Content="AI: подобрать характеристики (Cx, база, колея, фронт. площадь)"
                    Command="{Binding FetchAiCarSpecsCommand}"
                    IsEnabled="{Binding IsFetchingAiSpecs, Converter={StaticResource InvBool}}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left"
                    Padding="14,6"
                    Margin="0,0,0,8" />
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding WheelbaseFieldLabel}" Style="{StaticResource FormLabel}" MinWidth="100"/>
                        <TextBox   Grid.Column="1" Text="{Binding WheelbaseDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="2" Text="⚠" Foreground="{StaticResource AccentBrush}" FontSize="14"
                                   Visibility="{Binding IsWheelbaseAiEstimated, Converter={StaticResource BoolVis}}"
                                   ToolTip="Значение рассчитано AI, может быть неточным" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="{Binding FrontTrackFieldLabel}"   Style="{StaticResource FormLabel}" MinWidth="100"/>
                        <TextBox   Grid.Column="5" Text="{Binding FrontTrackDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="6" Text="⚠" Foreground="{StaticResource AccentBrush}" FontSize="14"
                                   Visibility="{Binding IsFrontTrackAiEstimated, Converter={StaticResource BoolVis}}"
                                   ToolTip="Значение рассчитано AI, может быть неточным" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <TextBlock Grid.Column="8" Text="{Binding RearTrackFieldLabel}"     Style="{StaticResource FormLabel}" MinWidth="90"/>
                        <TextBox   Grid.Column="9" Text="{Binding RearTrackDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="10" Text="⚠" Foreground="{StaticResource AccentBrush}" FontSize="14"
                                   Visibility="{Binding IsRearTrackAiEstimated, Converter={StaticResource BoolVis}}"
                                   ToolTip="Значение рассчитано AI, может быть неточным" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cx (коэф. лобового сопр.)" Style="{StaticResource FormLabel}" Width="210"
                                   ToolTip="Коэффициент лобового сопротивления кузова. При заполнении обоих полей заменяет оценку по массе/профилю. Типичные значения: спорткар 0.28–0.36, SUV 0.38–0.50."/>
                        <TextBox   Grid.Column="1" Text="{Binding Car.Cd, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="2" Text="⚠" Foreground="{StaticResource AccentBrush}" FontSize="14"
                                   Visibility="{Binding IsCdAiEstimated, Converter={StaticResource BoolVis}}"
                                   ToolTip="Значение рассчитано AI, может быть неточным" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="Площадь фронта (м²)" Style="{StaticResource FormLabel}" Width="170"
                                   ToolTip="Площадь лобового сечения кузова. Типичные значения: спорткар 1.8–2.1, SUV 2.5–3.2."/>
                        <TextBox   Grid.Column="5" Text="{Binding Car.FrontalAreaM2, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="6" Text="⚠" Foreground="{StaticResource AccentBrush}" FontSize="14"
                                   Visibility="{Binding IsFrontalAreaAiEstimated, Converter={StaticResource BoolVis}}"
                                   ToolTip="Значение рассчитано AI, может быть неточным" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Upgrades ────────────────────────────────────────────────── -->
            <TextBlock Text="ДЕТАЛИ" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Подвеска"     Style="{StaticResource FormLabel}" MinWidth="70"/>
                    <ComboBox  x:Name="SuspensionCombo" Grid.Column="1" SelectedValue="{Binding Car.SuspensionUpgrade}"/>
                    <TextBlock Grid.Column="3" Text="Дифференциал" Style="{StaticResource FormLabel}" MinWidth="80"/>
                    <ComboBox  x:Name="DiffCombo"        Grid.Column="4" SelectedValue="{Binding Car.DifferentialUpgrade}"/>
                    <TextBlock Grid.Column="6" Text="Тормоза"      Style="{StaticResource FormLabel}" MinWidth="60"/>
                    <ComboBox  x:Name="BrakesCombo"      Grid.Column="7" SelectedValue="{Binding Car.BrakesUpgrade}"/>
                </Grid>
            </Border>

            <!-- ── Constraints ───────────────────────────────────────────── -->
            <TextBlock Text="ОГРАНИЧЕНИЯ ТЮНИНГА" Style="{StaticResource SectionHeader}" FontSize="13"/>

            <TextBlock Text="{Binding SpringUnitLabel}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource BoolVis}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Перед — мин / макс" Style="{StaticResource FormLabel}" MinWidth="130"/>
                    <TextBox   Grid.Column="1" Text="{Binding SpringFrontMinDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="3" Text="{Binding SpringFrontMaxDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBlock Grid.Column="5" Text="Зад — мин / макс"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                    <TextBox   Grid.Column="6" Text="{Binding SpringRearMinDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="8" Text="{Binding SpringRearMaxDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding RideHeightUnitLabel}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource BoolVis}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Перед — мин / макс" Style="{StaticResource FormLabel}" MinWidth="130"/>
                    <TextBox   Grid.Column="1" Text="{Binding RideHeightFrontMinDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="3" Text="{Binding RideHeightFrontMaxDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBlock Grid.Column="5" Text="Зад — мин / макс"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                    <TextBox   Grid.Column="6" Text="{Binding RideHeightRearMinDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="8" Text="{Binding RideHeightRearMaxDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

            <TextBlock Text="АЭРОДИНАМИКА (ограничения)" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Content="Передний аэро-пакет установлен"
                                  IsChecked="{Binding Car.HasFrontAero}"
                                  Margin="0,0,32,0"/>
                        <CheckBox Content="Задний аэро-пакет установлен"
                                  IsChecked="{Binding Car.HasRearAero}"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,6" Visibility="{Binding Car.HasFrontAero, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Перед Мин / Макс" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.AeroFrontMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.AeroFrontMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid Visibility="{Binding Car.HasRearAero, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Зад Мин / Макс" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.AeroRearMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.AeroRearMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
