<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.CarCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
                 xmlns:m="clr-namespace:Forza_Horizon_6_Tune_Master.Models"
                 xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
                 Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <cv:AspirationTypeLabelConverter      x:Key="AspLabel"/>
        <cv:PowertrainTypeLabelConverter      x:Key="PtLabel"/>
        <cv:GenericEnumLabelConverter         x:Key="EnumLabel"/>
        <cv:BoolToVisibilityConverter         x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter  x:Key="BoolToCollapsed"/>
        <cv:EnumToBoolConverter               x:Key="E2B"/>
        <cv:InverseBoolConverter              x:Key="InvBool"/>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,24">

            <!-- ── Car Selection ─────────────────────────────────────────── -->
            <Grid Margin="0,6,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{l:Loc CarSelection}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="{DynamicResource FontMicro}"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCarDatabaseCommand}"
                            Style="{StaticResource IconButton}"
                            Width="24" Height="24"
                            Margin="6,0,0,0"
                            ToolTip="{l:Loc RefreshDbTooltip}">
                        <TextBlock Text="↻" FontSize="16" Margin="0,-4,0,0"/>
                    </Button>
                    <Button Command="{Binding ClearCacheCommand}"
                            Style="{StaticResource IconButton}"
                            Width="24" Height="24"
                            Margin="4,0,0,0"
                            ToolTip="{l:Loc ClearCacheTooltip}">
                        <TextBlock Text="🗑" FontSize="13" Margin="0,-1,0,0"/>
                    </Button>
                    <Button Command="{Binding ClearAiCacheCommand}"
                            Style="{StaticResource IconButton}"
                            Width="24" Height="24"
                            Margin="4,0,0,0"
                            ToolTip="{l:Loc ClearAiCacheTooltip}">
                        <TextBlock Text="🤖" FontSize="13" Margin="0,-1,0,0"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Border x:Name="CarSelectionCard" Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="CarSearchBox"
                                 Text="{Binding CarSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{l:Loc CarSearchPlaceholder}"
                                 GotFocus="CarSearchBox_GotFocus"
                                 LostFocus="CarSearchBox_LostFocus" />
                        <Button Grid.Column="1" Content="✕"
                                Command="{Binding ClearCarSelectionCommand}"
                                Style="{StaticResource IconButton}"
                                Width="30" Height="30"
                                Margin="6,0,0,0"
                                Click="ClearButton_Click"
                                ToolTip="{l:Loc CarSearchClearTooltip}"/>
                    </Grid>
                    <ListBox x:Name="CarListBox"
                             ItemsSource="{Binding FilteredCarDatabase}"
                             DisplayMemberPath="DisplayName"
                             SelectedItem="{Binding SelectedCar}"
                             MaxHeight="180"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="CarListBox_SelectionChanged"
                             Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ── Mass ─────────────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionMass}" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding MassFieldLabel}"    Style="{StaticResource FormLabel}" Width="170"/>
                    <TextBox   Grid.Column="1" Text="{Binding MassDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBlock Grid.Column="3" Text="{l:Loc WeightDistLabel}" Style="{StaticResource FormLabel}" Width="180"/>
                    <TextBox   Grid.Column="4" Text="{Binding Car.WeightDistributionFront, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

            <!-- ── Engine ───────────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionEngine}" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc PowertrainTypeLabel}" Style="{StaticResource FormLabel}" Width="200"/>
                        <ComboBox  x:Name="PowertrainTypeCombo" Grid.Column="1"
                                   SelectedValue="{Binding Car.PowertrainType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PtLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PowerFieldLabel}" Style="{StaticResource FormLabel}" MinWidth="100"/>
                        <TextBox   Grid.Column="1" Text="{Binding PowerDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="3" Text="{Binding TorqueFieldLabel}"     Style="{StaticResource FormLabel}" MinWidth="80"/>
                        <TextBox   Grid.Column="4" Text="{Binding TorqueDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="6" Text="{Binding MaxRPMFieldLabel}" Style="{StaticResource FormLabel}" MinWidth="80"/>
                        <TextBox   Grid.Column="7" Text="{Binding Car.MaxRPM,   UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding Car.IsElectricPowertrain, Converter={StaticResource BoolToCollapsed}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc EngineTypeLabel}" Style="{StaticResource FormLabel}" Width="150"/>
                        <ComboBox  x:Name="EngineTypeCombo" Grid.Column="1"
                                   SelectedValue="{Binding Car.EngineType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="3" Text="{l:Loc EnginePositionLabel}" Style="{StaticResource FormLabel}" Width="130"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Border Visibility="{Binding HasSelectedCar, Converter={StaticResource BoolVis}}"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                    CornerRadius="4" Padding="10,5" MinWidth="140">
                                <TextBlock x:Name="EnginePositionText"
                                           Text="{Binding Car.EnginePosition, Converter={StaticResource EnumLabel}}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </Border>
                            <ComboBox x:Name="EnginePositionCombo"
                                      Visibility="{Binding HasSelectedCar, Converter={StaticResource BoolToCollapsed}}"
                                      SelectedValue="{Binding Car.EnginePosition}"
                                      MinWidth="140">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding Car.IsElectricPowertrain, Converter={StaticResource BoolToCollapsed}}">
                        <TextBlock Text="{l:Loc FuelTypeLabel}" Style="{StaticResource FormLabel}" Width="150"/>
                        <RadioButton Content="{l:Loc FuelGasoline}" Margin="0,0,16,0"
                                     GroupName="FuelType"
                                     IsChecked="{Binding Car.FuelType, Converter={StaticResource E2B},
                                                 ConverterParameter={x:Static m:FuelType.Gasoline}}"/>
                        <RadioButton Content="{l:Loc FuelDiesel}"
                                     GroupName="FuelType"
                                     IsChecked="{Binding Car.FuelType, Converter={StaticResource E2B},
                                                 ConverterParameter={x:Static m:FuelType.Diesel}}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding Car.ShowAspiration, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc AspirationLabel}" Style="{StaticResource FormLabel}" Width="150"/>
                        <ComboBox  x:Name="AspirationCombo" Grid.Column="1"
                                   SelectedItem="{Binding Car.AspirationType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource AspLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <CheckBox Content="{l:Loc AntiLagLabel}"
                              IsChecked="{Binding Car.AntiLag}"
                              Visibility="{Binding Car.ShowAntiLag, Converter={StaticResource BoolVis}}"
                              Margin="150,0,0,8"/>
                    <!-- Computed RPM display -->
                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="5" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{l:Loc PowerPeakLabel}"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Car.PowerPeakRPM}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text=" " Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:Loc UnitRPM}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{l:Loc TorquePeakLabel}"
                                       Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="24,0,8,0"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Car.TorquePeakRPM}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text=" " Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{l:Loc UnitRPM}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Transmission ─────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionTransmission}" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc DriveTypeLabel}"  Style="{StaticResource FormLabel}" Width="130"/>
                        <ComboBox  x:Name="DriveTypeCombo" Grid.Column="1"
                                   SelectedValue="{Binding Car.DriveType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="3" Text="{l:Loc GearCountLabel}" Style="{StaticResource FormLabel}" Width="130"/>
                        <TextBox   Grid.Column="4" Text="{Binding Car.GearCount, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <CheckBox Content="{l:Loc CalcGearsLabel}"
                                  IsChecked="{Binding Car.AllowGearCalculation}"
                                  Margin="0,0,20,0"/>
                        <CheckBox Content="{l:Loc OnlyFinalLabel}"
                                  IsChecked="{Binding Car.OnlyFinalDriveCalculation}"
                                  Visibility="{Binding Car.AllowGearCalculation, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Tires ────────────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionTires}" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc FrontTireWidthLabel}" Style="{StaticResource FormLabel}" Width="175"/>
                        <TextBox   Grid.Column="1" Text="{Binding Car.FrontTireWidth,   UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="3" Text="{l:Loc FrontTireProfileLabel}" Style="{StaticResource FormLabel}" Width="70"/>
                        <TextBox   Grid.Column="4" Text="{Binding Car.FrontTireProfile, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="6" Text="{l:Loc FrontRimLabel}" Style="{StaticResource FormLabel}" Width="95"/>
                        <TextBox   Grid.Column="7" Text="{Binding Car.FrontRimDiameter, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc RearTireWidthLabel}"   Style="{StaticResource FormLabel}" Width="175"/>
                        <TextBox   Grid.Column="1" Text="{Binding Car.RearTireWidth,    UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="3" Text="{l:Loc RearTireProfileLabel}" Style="{StaticResource FormLabel}" Width="70"/>
                        <TextBox   Grid.Column="4" Text="{Binding Car.RearTireProfile,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="6" Text="{l:Loc RearRimLabel}" Style="{StaticResource FormLabel}" Width="95"/>
                        <TextBox   Grid.Column="7" Text="{Binding Car.RearRimDiameter,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:Loc TireTypeLabel}" Style="{StaticResource FormLabel}" Width="130"/>
                        <ComboBox  x:Name="TireTypeCombo" Width="200"
                                   SelectedValue="{Binding Car.TireType}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Car specs ─────────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionCarSpecs}" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding WheelbaseFieldLabel}" Style="{StaticResource FormLabel}" MinWidth="70"/>
                                <TextBox   Grid.Column="1" Text="{Binding WheelbaseDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                                <TextBlock Grid.Column="3" Text="{Binding FrontTrackFieldLabel}"   Style="{StaticResource FormLabel}" MinWidth="70"/>
                                <TextBox   Grid.Column="4" Text="{Binding FrontTrackDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                                <TextBlock Grid.Column="6" Text="{Binding RearTrackFieldLabel}"     Style="{StaticResource FormLabel}" MinWidth="60"/>
                                <TextBox   Grid.Column="7" Text="{Binding RearTrackDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:Loc CdLabel}" Style="{StaticResource FormLabel}" Width="140"
                                           ToolTip="{l:Loc CdTooltip}"/>
                                <TextBox   Grid.Column="1" Text="{Binding Car.Cd, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                                <TextBlock Grid.Column="3" Text="{l:Loc FrontalAreaLabel}" Style="{StaticResource FormLabel}" Width="120"
                                           ToolTip="{l:Loc FrontalAreaTooltip}"/>
                                <TextBox   Grid.Column="4" Text="{Binding Car.FrontalAreaM2, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="⚠" Foreground="{StaticResource AccentBrush}"
                                   FontSize="40" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding HasAnyAiEstimatedField, Converter={StaticResource BoolVis}}"
                                   ToolTip="{l:Loc AiEstimatedTooltip}"/>
                    </Grid>
                    <Button Grid.Column="1"
                            Content="AI"
                            Command="{Binding FetchAiCarSpecsCommand}"
                            IsEnabled="{Binding IsFetchingAiSpecs, Converter={StaticResource InvBool}}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="0"
                            FontSize="20" FontWeight="Bold"
                            VerticalAlignment="Stretch"
                            MinWidth="50" MinHeight="50"
                            Width="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight}"
                            Margin="12,0,0,0"
                            ToolTip="{l:Loc AiFetchButton}" />

                </Grid>
            </Border>

            <!-- ── Upgrades ────────────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionUpgrades}" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc SuspensionLabel}"     Style="{StaticResource FormLabel}" MinWidth="70"/>
                        <ComboBox  x:Name="SuspensionCombo" Grid.Column="1" SelectedValue="{Binding Car.SuspensionUpgrade}"
                                   SelectionChanged="SuspensionCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="3" Text="{l:Loc DiffLabel}" Style="{StaticResource FormLabel}" MinWidth="80"/>
                        <ComboBox  x:Name="DiffCombo"        Grid.Column="4" SelectedValue="{Binding Car.DifferentialUpgrade}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="6" Text="{l:Loc BrakesLabel}"      Style="{StaticResource FormLabel}" MinWidth="60"/>
                        <ComboBox  x:Name="BrakesCombo"      Grid.Column="7" SelectedValue="{Binding Car.BrakesUpgrade}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Stabilizers ─────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionARB}" Style="{StaticResource SectionHeader}" FontSize="13"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="{l:Loc FrontARBLabel}"
                              IsChecked="{Binding Car.HasFrontARB}"
                              Margin="0,0,32,0"/>
                    <CheckBox Content="{l:Loc RearARBLabel}"
                              IsChecked="{Binding Car.HasRearARB}"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SpringSectionHeader" Text="{Binding SpringUnitLabel}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource BoolVis}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                    </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc FrontMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding SpringFrontMinDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="3" Text="{Binding SpringFrontMaxDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBlock Grid.Column="5" Text="{l:Loc RearMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                    <TextBox   Grid.Column="6" Text="{Binding SpringRearMinDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="8" Text="{Binding SpringRearMaxDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding RideHeightUnitLabel}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource BoolVis}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                    </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc FrontMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding RideHeightFrontMinDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="3" Text="{Binding RideHeightFrontMaxDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBlock Grid.Column="5" Text="{l:Loc RearMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                    <TextBox   Grid.Column="6" Text="{Binding RideHeightRearMinDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox x:Name="RideHeightRearEndBox" Grid.Column="8" Text="{Binding RideHeightRearMaxDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

            <TextBlock x:Name="AeroSectionHeader" Text="{l:Loc SectionAeroConstraints}" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Content="{l:Loc FrontAeroLabel}"
                                  IsChecked="{Binding Car.HasFrontAero}"
                                  Checked="AeroCheckBox_Checked"
                                  Margin="0,0,32,0"/>
                        <CheckBox Content="{l:Loc RearAeroLabel}"
                                  IsChecked="{Binding Car.HasRearAero}"
                                  Checked="AeroCheckBox_Checked"/>
                    </StackPanel>
                    <Grid x:Name="AeroFrontGrid" Margin="0,0,0,6" Visibility="{Binding Car.HasFrontAero, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc AeroFrontMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.AeroFrontMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.AeroFrontMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid x:Name="AeroRearGrid" Visibility="{Binding Car.HasRearAero, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc AeroRearMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.AeroRearMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox x:Name="AeroEndBox" Grid.Column="3" Text="{Binding Constraints.AeroRearMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
