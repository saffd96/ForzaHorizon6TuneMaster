<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.TrackInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Forza_Horizon_6_Tune_Master.Models"
             xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <cv:EnumToBoolConverter              x:Key="E2B"/>
        <cv:BoolToVisibilityConverter        x:Key="B2V"/>
        <cv:InverseBoolToVisibilityConverter x:Key="IBV"/>

        <Style x:Key="DisciplineButton" TargetType="RadioButton">
            <Setter Property="GroupName"  Value="Discipline"/>
            <Setter Property="Margin"     Value="0,0,0,0"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{StaticResource ElevatedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="0">
                            <StackPanel Margin="10,8" HorizontalAlignment="Center">
                                <TextBlock x:Name="Icon"  FontSize="20" HorizontalAlignment="Center"
                                           Text="{TemplateBinding Tag}"/>
                                <TextBlock x:Name="Label" FontSize="{DynamicResource FontMicro}" FontFamily="Segoe UI"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Margin="0,3,0,0"
                                           Text="{TemplateBinding Content}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd"    Property="Background"   Value="#1E1A00"/>
                                <Setter TargetName="bd"    Property="BorderBrush"  Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd"    Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Label" Property="Foreground"   Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DragDistButton" TargetType="RadioButton">
            <Setter Property="GroupName"  Value="DragDist"/>
            <Setter Property="Margin"     Value="0,0,10,0"/>
            <Setter Property="Padding"    Value="20,8"/>
            <Setter Property="FontSize"   Value="{DynamicResource FontNormal}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{StaticResource ElevatedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#1E1A00"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,6,12,8">

            <TextBlock Text="РЕЖИМ ГОНОК" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <UniformGrid Rows="2" Columns="4" HorizontalAlignment="Stretch">
                    <!-- Row 1 -->
                    <RadioButton Tag="🛣️" Content="Шоссейные"
                                 Style="{StaticResource DisciplineButton}" Margin="0,0,8,8"
                                 IsChecked="{Binding Track.Discipline, Converter={StaticResource E2B}, ConverterParameter={x:Static m:Discipline.Road}}"
                                 ToolTip="Road Racing — асфальтовые трассы, упор на управляемость и скорость в поворотах."/>

                    <RadioButton Tag="⛰️" Content="Тогэ"
                                 Style="{StaticResource DisciplineButton}" Margin="0,0,8,8"
                                 IsChecked="{Binding Track.Discipline, Converter={StaticResource E2B}, ConverterParameter={x:Static m:Discipline.Touge}}"
                                 ToolTip="Touge — горные серпантины, требуют точности входа в поворот и стабильности."/>

                    <RadioButton Tag="🌧️" Content="Ралли"
                                 Style="{StaticResource DisciplineButton}" Margin="0,0,8,8"
                                 IsChecked="{Binding Track.Discipline, Converter={StaticResource E2B}, ConverterParameter={x:Static m:Discipline.Rally}}"
                                 ToolTip="Rally — смешанное покрытие, важны мягкая подвеска и прогнозируемое поведение."/>

                    <RadioButton Tag="🌲" Content="Кросс-кантри"
                                 Style="{StaticResource DisciplineButton}" Margin="0,0,0,8"
                                 IsChecked="{Binding Track.Discipline, Converter={StaticResource E2B}, ConverterParameter={x:Static m:Discipline.CrossCountry}}"
                                 ToolTip="Cross Country — полное бездорожье, максимальный ход подвески и прочность."/>

                    <!-- Row 2 -->
                    <RadioButton Tag="💨" Content="Дрифт"
                                 Style="{StaticResource DisciplineButton}" Margin="0,0,8,0"
                                 IsChecked="{Binding Track.Discipline, Converter={StaticResource E2B}, ConverterParameter={x:Static m:Discipline.Drift}}"
                                 ToolTip="Drift — управляемый занос, акцент на угол и контроль скольжения."/>

                    <RadioButton Tag="⚡" Content="Драг"
                                 Style="{StaticResource DisciplineButton}" Margin="0,0,8,0"
                                 IsChecked="{Binding Track.Discipline, Converter={StaticResource E2B}, ConverterParameter={x:Static m:Discipline.Drag}}"
                                 ToolTip="Drag Racing — гонки по прямой, максимальный перенос веса на старте."/>

                    <RadioButton Tag="🏆" Content="Вышибала"
                                 Style="{StaticResource DisciplineButton}" Margin="0,0,8,0"
                                 IsChecked="{Binding Track.Discipline, Converter={StaticResource E2B}, ConverterParameter={x:Static m:Discipline.Eliminator}}"
                                 ToolTip="Eliminator — королевская битва, универсальная настройка на смешанные условия."/>

                    <RadioButton Tag="🏙️" Content="Улица"
                                 Style="{StaticResource DisciplineButton}"
                                 IsChecked="{Binding Track.Discipline, Converter={StaticResource E2B}, ConverterParameter={x:Static m:Discipline.Street}}"
                                 ToolTip="Street Racing — городские трассы с гражданским трафиком. Важны скорость и манёвренность для объезда машин."/>
                </UniformGrid>
            </Border>

            <!-- Drag distance — shown only when Drag is selected -->
            <TextBlock Text="ДИСТАНЦИЯ ДРАГА" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Track.IsDrag, Converter={StaticResource B2V}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Track.IsDrag, Converter={StaticResource B2V}}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="⅛ мили"  Style="{StaticResource DragDistButton}"
                                 IsChecked="{Binding Track.DragDistance, Converter={StaticResource E2B}, ConverterParameter={x:Static m:DragDistance.Eighth}}"/>
                    <RadioButton Content="¼ мили"  Style="{StaticResource DragDistButton}"
                                 IsChecked="{Binding Track.DragDistance, Converter={StaticResource E2B}, ConverterParameter={x:Static m:DragDistance.Quarter}}"/>
                    <RadioButton Content="½ мили"  Style="{StaticResource DragDistButton}"
                                 IsChecked="{Binding Track.DragDistance, Converter={StaticResource E2B}, ConverterParameter={x:Static m:DragDistance.Half}}"/>
                    <RadioButton Content="1 миля"  Style="{StaticResource DragDistButton}"
                                 IsChecked="{Binding Track.DragDistance, Converter={StaticResource E2B}, ConverterParameter={x:Static m:DragDistance.Mile}}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
