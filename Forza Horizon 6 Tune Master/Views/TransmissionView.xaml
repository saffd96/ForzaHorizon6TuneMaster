<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.TransmissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services">
    <StackPanel>
        <TextBlock Text="{l:Loc ModuleTransmission}" Style="{StaticResource SectionHeader}"/>
        <UniformGrid Columns="6" HorizontalAlignment="Stretch" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding Clutches}" SelectedItem="{Binding SelectedClutch}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding Clutches.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding Transmissions}" SelectedItem="{Binding SelectedTransmission}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding Transmissions.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding Drivelines}" SelectedItem="{Binding SelectedDriveline}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding Drivelines.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding Differentials}" SelectedItem="{Binding SelectedDifferential}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding Differentials.Count, Converter={StaticResource CountVis}}"/>
        </UniformGrid>
    </StackPanel>
</UserControl>
