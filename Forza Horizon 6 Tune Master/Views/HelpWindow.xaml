<Window x:Class="Forza_Horizon_6_Tune_Master.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
        Title="{l:Loc HelpWindowTitle}"
        Width="600" Height="800"
        MinWidth="460" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="{l:Loc HelpTitle}"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{l:Loc AppDescription}"
                           FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16">
            <StackPanel>

                <!-- Step 1: Car selection -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Loc HelpStep1Title}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="{l:Loc HelpStep1Text}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="{l:Loc HelpStep1Note}"/>
                    </StackPanel>
                </Border>

                <!-- Step 2: Car data -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CyanBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Loc HelpStep2Title}"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="{l:Loc HelpStep2Text}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="{l:Loc HelpStep2Note}"/>
                    </StackPanel>
                </Border>

                <!-- Step 3: Tires, specs, upgrades -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Loc HelpStep3Title}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="{l:Loc HelpStep3Text}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="{l:Loc HelpStep3Note}"/>
                    </StackPanel>
                </Border>

                <!-- Step 4: Constraints -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CyanBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Loc HelpStep4Title}"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="{l:Loc HelpStep4Text}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="{l:Loc HelpStep4Note}"/>
                    </StackPanel>
                </Border>

                <!-- Step 5: Discipline + Generate -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Loc HelpStep5Title}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="{l:Loc HelpStep5Text}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="{l:Loc HelpStep5Note}"/>
                    </StackPanel>
                </Border>

                <!-- Step 6: Results -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CyanBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Loc HelpStep6Title}"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="{l:Loc HelpStep6Text}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="8,4,0,0"
                                   Text="{l:Loc HelpStep6Line1}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="8,2,0,0"
                                   Text="{l:Loc HelpStep6Line2}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="8,2,0,0"
                                   Text="{l:Loc HelpStep6Line3}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="8,2,0,0"
                                   Text="{l:Loc HelpStep6Line4}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="8,2,0,0"
                                   Text="{l:Loc HelpStep6Line5}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="8,2,0,0"
                                   Text="{l:Loc HelpStep6Line6}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="8,2,0,0"
                                   Text="{l:Loc HelpStep6Line7}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="8,2,0,0"
                                   Text="{l:Loc HelpStep6Line8}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="8,2,0,0"
                                   Text="{l:Loc HelpStep6Line9}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="{l:Loc HelpStep6Line10}"/>
                    </StackPanel>
                </Border>

                <!-- Step 7: Launch Control -->
                <Border Background="{StaticResource ElevatedBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Loc HelpStep7Title}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="{l:Loc HelpStep7Text}"/>
                    </StackPanel>
                </Border>

                <!-- Step 8: Profiles + Units -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CyanBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{l:Loc HelpStep8Title}"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="{l:Loc HelpStep8Text}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="{l:Loc HelpStep8Note}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Button Content="{l:Loc HelpClose}"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Padding="24,8"
                    Click="OkButton_Click"/>
        </Border>
    </Grid>
</Window>
