<Window x:Class="Forza_Horizon_6_Tune_Master.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
        Title="{l:Loc HelpWindowTitle}"
        Width="660" Height="820"
        MinWidth="500" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Step badge with glow -->
                <Border Grid.Column="0"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="20"
                        Width="44" Height="44"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF5E0E" Opacity="0.3" BlurRadius="10" ShadowDepth="0"/>
                    </Border.Effect>
                    <TextBlock Text="10"
                                FontSize="{DynamicResource FontHeading}" FontWeight="Bold"
                                Foreground="#FFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc HelpTitle}"
                               FontSize="{DynamicResource FontTitle}" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{l:Loc AppDescription}"
                               FontSize="{DynamicResource FontSmall}" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step label -->
        <Border Grid.Row="1"
                Background="{StaticResource ElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <TextBlock Text="{l:Loc HelpProgressLabel}"
                       FontSize="{DynamicResource FontXSmall}" Foreground="{StaticResource TextMutedBrush}"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16"
                      Background="{StaticResource BgBrush}">
            <StackPanel>

                <!-- Step 0 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="0"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep0Title}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep0Text}"/>
                            <Border Background="{StaticResource ElevatedBrush}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Text="{l:Loc HelpStep0Note}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 1 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="1"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep1Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep1Text}"/>
                            <Border Background="{StaticResource ElevatedBrush}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Text="{l:Loc HelpStep1Note}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 2 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="2"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep2Title}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep2Text}"/>
                            <Border Background="{StaticResource ElevatedBrush}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Text="{l:Loc HelpStep2Note}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 3 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="3"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep3Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep3Text}"/>
                            <Border Background="{StaticResource ElevatedBrush}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Text="{l:Loc HelpStep3Note}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 4 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="4"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep4Title}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep4Text}"/>
                            <Border Background="{StaticResource ElevatedBrush}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Text="{l:Loc HelpStep4Note}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 5 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="5"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep5Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep5Text}"/>
                            <Border Background="{StaticResource ElevatedBrush}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Text="{l:Loc HelpStep5Note}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 6 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="6"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep6Title}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep6Text}"/>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="6"
                                    Padding="14,12"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Text="{l:Loc HelpStep6Line1}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Margin="0,2,0,0"
                                               Text="{l:Loc HelpStep6Line2}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Margin="0,2,0,0"
                                               Text="{l:Loc HelpStep6Line3}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Margin="0,2,0,0"
                                               Text="{l:Loc HelpStep6Line4}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Margin="0,2,0,0"
                                               Text="{l:Loc HelpStep6Line5}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Margin="0,2,0,0"
                                               Text="{l:Loc HelpStep6Line6}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Margin="0,2,0,0"
                                               Text="{l:Loc HelpStep6Line7}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Margin="0,2,0,0"
                                               Text="{l:Loc HelpStep6Line8}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Margin="0,2,0,0"
                                               Text="{l:Loc HelpStep6Line9}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource TextDimBrush}"
                                               Text="{l:Loc HelpStep6Line10}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 7 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="7"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep7Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep7Text}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 8 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="8"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep8Title}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep8Text}"/>
                            <Border Background="{StaticResource ElevatedBrush}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Text="{l:Loc HelpStep8Note}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 9 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="10,0,0,10"
                                BorderThickness="0">
                            <TextBlock Text="9"
                                       FontSize="{DynamicResource ValueFontSize}" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep9Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="{DynamicResource FontSmall}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontNormal}" LineHeight="20"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{l:Loc HelpStep9Text}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom cards row -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Donate -->
                    <Border Grid.Column="0"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="#2AFF5E0E"
                                    CornerRadius="14"
                                    Width="28" Height="28"
                                    VerticalAlignment="Top"
                                    Margin="0,0,10,0">
                                <TextBlock Text="❤"
                                           FontSize="{DynamicResource FontHeading}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{l:Loc HelpDonateText}"
                                       TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                       Foreground="{StaticResource TextDimBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Feedback -->
                    <Border Grid.Column="2"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="#2A1ABCFE"
                                    CornerRadius="14"
                                    Width="28" Height="28"
                                    VerticalAlignment="Top"
                                    Margin="0,0,10,0">
                                <TextBlock Text="✉"
                                           FontSize="{DynamicResource FontHeading}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{l:Loc HelpFeedbackText}"
                                       TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="18"
                                       Foreground="{StaticResource TextDimBrush}"/>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Don't show again (first run only) -->
                <CheckBox Grid.Column="0"
                          x:Name="DontShowAgainCheck"
                          Content="{l:Loc HelpDontShowAgain}"
                          Foreground="{StaticResource TextDimBrush}"
                          FontSize="{DynamicResource FontSmall}"
                          VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="{l:Loc HelpClose}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="28,8"
                        Click="OkButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
