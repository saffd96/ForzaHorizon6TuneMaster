<Window x:Class="Forza_Horizon_6_Tune_Master.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
        Title="{l:Loc HelpWindowTitle}"
        Width="660" Height="820"
        MinWidth="500" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Step badge -->
                <Border Grid.Column="0"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="20"
                        Width="44" Height="44"
                        VerticalAlignment="Center">
                    <TextBlock Text="8"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc HelpTitle}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{l:Loc AppDescription}"
                               FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step label -->
        <Border Grid.Row="1"
                Background="{StaticResource ElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <TextBlock Text="{l:Loc HelpProgressLabel}"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16"
                      Background="{StaticResource BgBrush}">
            <StackPanel>

                <!-- Step 1: Car selection -->
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="8,0,0,8">
                            <TextBlock Text="1"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep1Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Text="{l:Loc HelpStep1Text}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Text="{l:Loc HelpStep1Note}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 2: Car data -->
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="8,0,0,8">
                            <TextBlock Text="2"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep2Title}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Text="{l:Loc HelpStep2Text}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Text="{l:Loc HelpStep2Note}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 3: Tires, specs, upgrades -->
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="8,0,0,8">
                            <TextBlock Text="3"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep3Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Text="{l:Loc HelpStep3Text}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Text="{l:Loc HelpStep3Note}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 4: Constraints -->
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="8,0,0,8">
                            <TextBlock Text="4"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep4Title}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Text="{l:Loc HelpStep4Text}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Text="{l:Loc HelpStep4Note}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 5: Discipline + Generate -->
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="8,0,0,8">
                            <TextBlock Text="5"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep5Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Text="{l:Loc HelpStep5Text}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Text="{l:Loc HelpStep5Note}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 6: Results -->
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="8,0,0,8">
                            <TextBlock Text="6"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep6Title}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Text="{l:Loc HelpStep6Text}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="8,6,0,0"
                                       Text="{l:Loc HelpStep6Line1}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="8,2,0,0"
                                       Text="{l:Loc HelpStep6Line2}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="8,2,0,0"
                                       Text="{l:Loc HelpStep6Line3}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="8,2,0,0"
                                       Text="{l:Loc HelpStep6Line4}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="8,2,0,0"
                                       Text="{l:Loc HelpStep6Line5}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="8,2,0,0"
                                       Text="{l:Loc HelpStep6Line6}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="8,2,0,0"
                                       Text="{l:Loc HelpStep6Line7}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="8,2,0,0"
                                       Text="{l:Loc HelpStep6Line8}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="8,2,0,0"
                                       Text="{l:Loc HelpStep6Line9}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Text="{l:Loc HelpStep6Line10}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 7: Launch Control -->
                <Border Background="{StaticResource ElevatedBrush}"
                        CornerRadius="8" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="8,0,0,8">
                            <TextBlock Text="7"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep7Title}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Text="{l:Loc HelpStep7Text}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 8: Profiles + Units -->
                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="8" Padding="0" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{StaticResource CyanBrush}"
                                CornerRadius="8,0,0,8">
                            <TextBlock Text="8"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,16">
                            <TextBlock Text="{l:Loc HelpStep8Title}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                       Text="{l:Loc HelpStep8Text}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Text="{l:Loc HelpStep8Note}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Don't show again (first run only) -->
                <CheckBox Grid.Column="0"
                          x:Name="DontShowAgainCheck"
                          Content="{l:Loc HelpDontShowAgain}"
                          Foreground="{StaticResource TextDimBrush}"
                          FontSize="12"
                          VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="{l:Loc HelpClose}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="28,8"
                        Click="OkButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
