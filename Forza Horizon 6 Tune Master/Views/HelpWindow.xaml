<Window x:Class="Forza_Horizon_6_Tune_Master.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка — Tune Master"
        Width="580" Height="740"
        MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="Как пользоваться Tune Master"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Генератор оптимального тюнинга для Forza Horizon 6"
                           FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16">
            <StackPanel>

                <!-- Step 1 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1 — ДАННЫЕ АВТОМОБИЛЯ"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="Заполните левую панель: марка, модель, год, масса, распределение веса, мощность, момент, максимальные обороты. Укажите тип двигателя, расположение, наддув и тип привода — они влияют на расчёт пружин, дифференциала и ряда передач."/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="Тип топлива (Бензин / Дизель) — влияет на пик крутящего момента и ряд передач. Дизель получает более короткую первую передачу и плотный ряд, так как его рабочий диапазон оборотов у́же."/>
                    </StackPanel>
                </Border>

                <!-- Step 2 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CyanBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="2 — ОГРАНИЧЕНИЯ ТЮНИНГА"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="В нижней части левой панели задайте допустимые диапазоны для пружин, дорожного просвета и аэродинамики. Генератор не выйдет за эти границы. Если аэро-пакет не установлен — оставьте аэро-ограничения на нулях."/>
                    </StackPanel>
                </Border>

                <!-- Step 3 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="3 — ВЫБЕРИТЕ ДИСЦИПЛИНУ"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="В нижней панели выберите режим: Шоссе, Тоуге, Дрифт, Дрэг, Ралли, Бездорожье, Вышибала или Улица. Каждая дисциплина использует свои формулы жёсткости, геометрии и ряда передач. Для дрэга укажите дистанцию (⅛, ¼, ½ мили или миля)."/>
                    </StackPanel>
                </Border>

                <!-- Step 4 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CyanBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="4 — ГЕНЕРАЦИЯ ТЮНИНГА"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="Нажмите «⚡ Сгенерировать» внизу. Включите «✓ Авто» в шапке правой панели — тюнинг будет пересчитываться мгновенно при любом изменении данных."/>
                    </StackPanel>
                </Border>

                <!-- Step 5 -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="5 — ПРОСМОТР РЕЗУЛЬТАТОВ"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="Правая панель показывает все параметры: давление шин, геометрия, ARB, пружины, клиренс, амортизаторы, аэро, дифференциал, тормоза и трансмиссия. Наведи курсор на любое значение — всплывающая подсказка объяснит физику расчёта."/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="График передач внизу показывает скоростной диапазон каждой ступени. Вертикальные линии — пик мощности (оранжевый) и пик момента (голубой). Идеально, когда переходы между передачами перекрываются с рабочей зоной мотора."/>
                    </StackPanel>
                </Border>

                <!-- Step 6: Launch Control -->
                <Border Background="{StaticResource ElevatedBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="6 — LAUNCH CONTROL (ДРЭГ)"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="В режиме дрэга отображаются оптимальные обороты для старта. Удержи газ на этих оборотах перед флагом. Расчёт учитывает тип наддува, пик момента, тип привода и тип топлива: дизель получает пониженные обороты старта из-за раннего пика момента."/>
                    </StackPanel>
                </Border>

                <!-- Step 7: Profiles -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CyanBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="7 — ПРОФИЛИ"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="«💾 Сохранить» — сохраняет всё: параметры авто, ограничения и тюнинг. Имя формируется автоматически из марки, модели, года и дисциплины. Выбери профиль из списка — он загрузится сразу. «+ Новый» сбрасывает поля к значениям по умолчанию."/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="Имя активного профиля отображается в заголовке карточки тюнинга справа. При новом тюне без сохранённого профиля показывается автосгенерированное имя."/>
                    </StackPanel>
                </Border>

                <!-- Step 8: Export + Units -->
                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="3,0,0,0"
                        CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="8 — ЭКСПОРТ, ИМПОРТ И ЕДИНИЦЫ"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13"
                                   Text="«💾 Экспорт» сохраняет тюнинг как текстовый файл для публикации в Forza-сообществе. «📂 Импорт» загружает параметры авто из текстового файла и пересчитывает тюн."/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Text="Единицы переключаются в верхней панели: Метрические / Имперские, мощность в л.с. / PS / кВт, жёсткость пружин в кгс/мм · Н/мм · фунт/дюйм. Все внутренние расчёты ведутся в метрических единицах — конвертация только для отображения."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Button Content="OK — Закрыть"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Padding="24,8"
                    Click="OkButton_Click"/>
        </Border>
    </Grid>
</Window>
