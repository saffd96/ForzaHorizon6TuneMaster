<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.SuspensionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services">
    <StackPanel>
        <TextBlock Text="{l:Loc SectionSuspensionParts}" Style="{StaticResource SectionHeader}"/>
        <UniformGrid Columns="6" HorizontalAlignment="Stretch" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding SpringDampers}" SelectedItem="{Binding SelectedSpringDamper}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding SpringDampers.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding AntiSwayFront}" SelectedItem="{Binding SelectedAntiSwayFront}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding AntiSwayFront.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding AntiSwayRear}" SelectedItem="{Binding SelectedAntiSwayRear}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding AntiSwayRear.Count, Converter={StaticResource CountVis}}"/>
        </UniformGrid>

        <TextBlock Text="{l:Loc SectionBrakeParts}" Style="{StaticResource SectionHeader}"/>
        <UniformGrid Columns="6" HorizontalAlignment="Stretch" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding Brakes}" SelectedItem="{Binding SelectedBrake}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding Brakes.Count, Converter={StaticResource CountVis}}"/>
        </UniformGrid>
    </StackPanel>
</UserControl>
