<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.TuningConstraintsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="MinMaxRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <cv:BoolToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">

            <TextBlock Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"
                       Text="{l:Loc ConstraintHint}"/>

            <!-- Helper template -->
            <!-- ── Tire Pressure ─────────────────────────────────────── -->
            <TextBlock Text="{Binding TirePressureUnitLabel}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}">
                <StackPanel>
                    <Grid Style="{StaticResource MinMaxRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc FrontMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding TirePressureFrontMinDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding TirePressureFrontMaxDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="5" Text="{l:Loc RearMinMaxLabel}"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="6" Text="{Binding TirePressureRearMinDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="8" Text="{Binding TirePressureRearMaxDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Alignment ─────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionAlignment}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}">
                <StackPanel>
                    <Grid Style="{StaticResource MinMaxRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc CamberFrontLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.CamberFrontMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.CamberFrontMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="5" Text="{l:Loc CamberRearLabel}"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="6" Text="{Binding Constraints.CamberRearMin,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="8" Text="{Binding Constraints.CamberRearMax,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid Style="{StaticResource MinMaxRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc ToeFrontLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.ToeFrontMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.ToeFrontMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="5" Text="{l:Loc ToeRearLabel}"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="6" Text="{Binding Constraints.ToeRearMin,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="8" Text="{Binding Constraints.ToeRearMax,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid Style="{StaticResource MinMaxRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc CasterLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.CasterMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.CasterMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── ARB ───────────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionARB}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.HasAnyARB, Converter={StaticResource B2V}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.HasAnyARB, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                    </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc ArbFrontLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.ARBFrontMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.ARBFrontMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="5" Text="{l:Loc ArbRearLabel}"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="6" Text="{Binding Constraints.ARBRearMin,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="8" Text="{Binding Constraints.ARBRearMax,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

            <!-- ── Springs ───────────────────────────────────────────── -->
            <TextBlock Text="{Binding SpringUnitLabel}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                    </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc FrontMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding SpringFrontMinDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding SpringFrontMaxDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="5" Text="{l:Loc RearMinMaxLabel}"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="6" Text="{Binding SpringRearMinDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="8" Text="{Binding SpringRearMaxDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

            <!-- ── Ride Height ───────────────────────────────────────── -->
            <TextBlock Text="{Binding RideHeightUnitLabel}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                    </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc FrontMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding RideHeightFrontMinDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding RideHeightFrontMaxDisplay, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="5" Text="{l:Loc RearMinMaxLabel}"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="6" Text="{Binding RideHeightRearMinDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="8" Text="{Binding RideHeightRearMaxDisplay,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

            <!-- ── Dampers ───────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionDampers}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}">
                <StackPanel>
                    <Grid Style="{StaticResource MinMaxRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc ReboundFrontLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.ReboundFrontMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.ReboundFrontMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="5" Text="{l:Loc ReboundRearLabel}"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="6" Text="{Binding Constraints.ReboundRearMin,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="8" Text="{Binding Constraints.ReboundRearMax,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc BumpFrontLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.BumpFrontMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.BumpFrontMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="5" Text="{l:Loc BumpRearLabel}"   Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="6" Text="{Binding Constraints.BumpRearMin,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="8" Text="{Binding Constraints.BumpRearMax,  UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Differential ──────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionDiff}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}">
                <StackPanel>
                    <Grid Style="{StaticResource MinMaxRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc DiffAccelLabel}"    Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.DiffAccelMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.DiffAccelMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBlock Grid.Column="5" Text="{l:Loc DiffDecelLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="6" Text="{Binding Constraints.DiffDecelMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="8" Text="{Binding Constraints.DiffDecelMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <!-- AWD centre diff bias -->
                    <StackPanel Visibility="{Binding HasCenterDiffBias, Converter={StaticResource B2V}}">
                        <Separator Margin="0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{l:Loc DiffCenterLabel}"
                                       Style="{StaticResource FormLabel}" MinWidth="130"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                    Value="{Binding Constraints.CenterDiffBias}"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Constraints.CenterDiffBias, StringFormat='{}{0:F0}%'}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{l:Loc DiffCenterHint}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" Margin="200,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Aero ──────────────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionAero}" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc AeroFrontMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.AeroFrontMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.AeroFrontMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*" MinWidth="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:Loc AeroRearMinMaxLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                        <TextBox   Grid.Column="1" Text="{Binding Constraints.AeroRearMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                        <TextBox   Grid.Column="3" Text="{Binding Constraints.AeroRearMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Final Drive ───────────────────────────────────────── -->
            <TextBlock Text="{l:Loc SectionFinalDrive}" Style="{StaticResource SectionHeader}"
                       Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}"/>
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding Car.SuspensionAllowsAdvancedTuning, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="130"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l:Loc FinalDriveLabel}" Style="{StaticResource FormLabel}" MinWidth="130"/>
                    <TextBox   Grid.Column="1" Text="{Binding Constraints.FinalDriveMin, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                    <TextBox   Grid.Column="3" Text="{Binding Constraints.FinalDriveMax, UpdateSourceTrigger=LostFocus}" cv:NumericBehavior.IsNumeric="True"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
