<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.TiresWheelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services">
    <StackPanel>
        <TextBlock Text="{l:Loc SectionTireParts}" Style="{StaticResource SectionHeader}"/>
        <UniformGrid Columns="6" HorizontalAlignment="Stretch" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding TireCompounds}" SelectedItem="{Binding SelectedTireCompound}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding TireCompounds.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding TireWidthsFront}" SelectedItem="{Binding SelectedTireWidthFront}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding TireWidthsFront.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding TireWidthsRear}" SelectedItem="{Binding SelectedTireWidthRear}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding TireWidthsRear.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding TireAspectRatiosFront}" SelectedItem="{Binding SelectedTireAspectRatioFront}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding TireAspectRatiosFront.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding TireAspectRatiosRear}" SelectedItem="{Binding SelectedTireAspectRatioRear}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding TireAspectRatiosRear.Count, Converter={StaticResource CountVis}}"/>
        </UniformGrid>

        <TextBlock Text="{l:Loc SectionRimParts}" Style="{StaticResource SectionHeader}"/>
        <UniformGrid Columns="6" HorizontalAlignment="Stretch" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding RimsFront}" SelectedItem="{Binding SelectedRimFront}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding RimsFront.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding RimsRear}" SelectedItem="{Binding SelectedRimRear}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding RimsRear.Count, Converter={StaticResource CountVis}}"/>
        </UniformGrid>

        <TextBlock Text="{l:Loc SectionSpacerParts}" Style="{StaticResource SectionHeader}"/>
        <UniformGrid Columns="6" HorizontalAlignment="Stretch" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding TrackSpacingsFront}" SelectedItem="{Binding SelectedTrackSpacingFront}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding TrackSpacingsFront.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding TrackSpacingsRear}" SelectedItem="{Binding SelectedTrackSpacingRear}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding TrackSpacingsRear.Count, Converter={StaticResource CountVis}}"/>
        </UniformGrid>
    </StackPanel>
</UserControl>
