<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.AeroVisualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Forza_Horizon_6_Tune_Master.Views"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services">
    <StackPanel>
        <TextBlock Text="{l:Loc SectionAeroParts}" Style="{StaticResource PartGroupHeader}" Margin="0,0,0,4"/>
        <v:PartRow Label="{l:Loc Part_FrontBumper}" Options="{Binding FrontBumpers}" Selected="{Binding SelectedFrontBumper}"/>
        <v:PartRow Label="{l:Loc Part_RearWing}"    Options="{Binding RearWings}"    Selected="{Binding SelectedRearWing}"/>
        <v:PartRow Label="{l:Loc Part_RearBumper}"  Options="{Binding RearBumpers}"  Selected="{Binding SelectedRearBumper}"/>
        <v:PartRow Label="{l:Loc Part_SideSkirts}"  Options="{Binding SideSkirts}"   Selected="{Binding SelectedSideSkirt}"/>
        <v:PartRow Label="{l:Loc Part_Hood}"        Options="{Binding Hoods}"        Selected="{Binding SelectedHood}"/>
    </StackPanel>
</UserControl>
