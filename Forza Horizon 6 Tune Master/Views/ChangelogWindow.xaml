<Window x:Class="Forza_Horizon_6_Tune_Master.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
        Title="{l:Loc ChangelogWindowTitle}"
        Width="560" Height="620"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="20"
                        Width="44" Height="44"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#FF5E0E" Opacity="0.3" BlurRadius="10" ShadowDepth="0"/>
                    </Border.Effect>
                    <TextBlock Text="v"
                               FontSize="{DynamicResource FontHeading}" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc ChangelogTitle}"
                               FontSize="{DynamicResource FontTitle}" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="{DynamicResource FontSmall}" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16"
                      Background="{StaticResource BgBrush}">
            <StackPanel>
                <ItemsControl x:Name="VersionsList" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10" Padding="20,16" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Body}"
                                           TextWrapping="Wrap" FontSize="{DynamicResource FontSmall}" LineHeight="20"
                                           Foreground="{StaticResource TextBrush}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Button Content="{l:Loc ChangelogClose}"
                    Style="{StaticResource PrimaryButton}"
                    Padding="28,8"
                    HorizontalAlignment="Right"
                    Click="OkButton_Click"/>
        </Border>
    </Grid>
</Window>
