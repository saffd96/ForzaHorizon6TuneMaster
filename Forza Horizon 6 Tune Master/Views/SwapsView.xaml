<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.SwapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services">
    <StackPanel>
        <TextBlock Text="{l:Loc SectionSwaps}" Style="{StaticResource SectionHeader}"/>
        <UniformGrid Columns="6" HorizontalAlignment="Stretch" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding EngineSwaps}" SelectedItem="{Binding SelectedEngineSwap}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding EngineSwaps.Count, Converter={StaticResource CountVis}}"/>
            <ComboBox ItemsSource="{Binding ForcedInductions}" SelectedItem="{Binding SelectedForcedInduction}"
                      HorizontalAlignment="Stretch" MinHeight="26"
                      FontSize="{DynamicResource FontSmall}" Margin="2,0,2,3"
                      Visibility="{Binding ForcedInductions.Count, Converter={StaticResource CountVis}}"/>
        </UniformGrid>
    </StackPanel>
</UserControl>
