<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.SwapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Forza_Horizon_6_Tune_Master.Views"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services">
    <StackPanel>
        <TextBlock Text="{l:Loc SectionSwaps}" Style="{StaticResource PartGroupHeader}" Margin="0,0,0,4"/>
        <v:PartRow Label="{l:Loc Part_Engine}"           Options="{Binding EngineSwaps}"          Selected="{Binding SelectedEngineSwap}"/>
        <v:PartRow Label="{l:Loc SectionDrivetrainSwap}" Options="{Binding DrivetrainSwaps}"       Selected="{Binding SelectedDrivetrainSwap}"/>
        <v:PartRow Label="{l:Loc AspirationLabel}"       Options="{Binding ForcedInductions}"      Selected="{Binding SelectedForcedInduction}"/>
    </StackPanel>
</UserControl>
