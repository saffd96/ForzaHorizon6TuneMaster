<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.TuneResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Forza_Horizon_6_Tune_Master.Views"
             xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <cv:NullToVisibilityConverter        x:Key="N2V"/>
        <cv:InverseBoolToVisibilityConverter x:Key="IBV"/>
        <cv:BoolToVisibilityConverter        x:Key="B2V"/>
        <cv:UnitValueConverter               x:Key="UV"/>
        <cv:AddOneConverter                  x:Key="AddOne"/>

        <!-- FontSize scales live with panel width via code-behind DynamicResource -->
        <Style x:Key="ValueDisplay" TargetType="TextBlock" BasedOn="{StaticResource ValueDisplay}">
            <Setter Property="FontSize" Value="{DynamicResource ValueFontSize}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚡ ТЮНИНГ" Style="{StaticResource SubtitleText}"
                           FontSize="14" FontWeight="Bold"/>
                <Button Grid.Column="1" Content="📂 Импорт" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ImportTextCommand}"
                        Height="26" Padding="8,3" FontSize="11" Margin="0,0,4,0"/>
                <Button Grid.Column="2" Content="💾 Экспорт" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportTextCommand}"
                        Height="26" Padding="8,3" FontSize="11" Margin="0,0,8,0"/>
                <CheckBox Grid.Column="3"
                          IsChecked="{Binding IsAutoGenerate}"
                          Content="✓ Авто"
                          Foreground="{StaticResource TextDimBrush}"
                          VerticalAlignment="Center"
                          FontSize="11"/>
            </Grid>
        </Border>

        <!-- ── Content ───────────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource IBV}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🏎" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Тюнинг ещё не сгенерирован"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Заполните вкладки «Автомобиль» и «Режим», затем нажмите «Сгенерировать тюн»"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Result -->
            <ScrollViewer Visibility="{Binding HasResult, Converter={StaticResource B2V}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,8,8,12">

                    <!-- Header card -->
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="0,0,0,2"
                            CornerRadius="8,8,0,0"
                            Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding TuneResult.Car.Name, FallbackValue='—'}"
                                           FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding TuneResult.Car.Make}"    Foreground="{StaticResource TextDimBrush}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding TuneResult.Car.Model}"   Foreground="{StaticResource TextDimBrush}"/>
                                    <Run Text="  •  "                            Foreground="{StaticResource TextMutedBrush}"/>
                                    <Run Text="{Binding TuneResult.Track.Discipline}" Foreground="{StaticResource AccentBrush}"/>
                                    <Run Text="  •  "                            Foreground="{StaticResource TextMutedBrush}"/>
                                    <Run Text="{Binding TuneResult.Car.DriveType}"    Foreground="{StaticResource CyanBrush}"/>
                                    <Run Text="  "/>
                                    <Run Foreground="{StaticResource TextDimBrush}">
                                        <Run.Text>
                                            <MultiBinding Converter="{StaticResource UV}" ConverterParameter="power">
                                                <Binding Path="TuneResult.Car.PowerHP"/>
                                                <Binding Path="PowerUnit"/>
                                            </MultiBinding>
                                        </Run.Text>
                                    </Run>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Text="{Binding TuneResult.CreatedAt, StringFormat='Сгенерировано: {0:dd.MM.yyyy  HH:mm}'}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                       TextWrapping="Wrap" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- ── Launch Control (Drag only) ────────────── -->
                    <Border Visibility="{Binding HasLaunchControl, Converter={StaticResource B2V}}"
                            Background="{StaticResource ElevatedBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="6" Margin="0,0,0,8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🚦 LAUNCH CONTROL"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}"
                                           Text="Оптимальные обороты для старта. Удержи педаль газа на этих оборотах перед спуском флага."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="16,0,4,0">
                                <TextBlock Text="{Binding TuneResult.LaunchControlRpm, StringFormat='{}{0:F0}'}"
                                           FontSize="{DynamicResource FontHuge}" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="ОБ/МИН" Style="{StaticResource ParamLabel}"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── 2-column parameter grid ──────────────── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tire Pressure -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="ДАВЛЕНИЕ ШИН" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[TirePressure]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="pressure">
                                                    <Binding Path="TuneResult.TirePressureFront"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="ПЕРЕД" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[TirePressure]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="pressure">
                                                    <Binding Path="TuneResult.TirePressureRear"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="ЗАД" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Geometry -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="УГЛЫ КОЛЁС" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.CamberFront, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Camber]}"/>
                                        <TextBlock Text="РАЗВАЛ П" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.CamberRear, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Camber]}"/>
                                        <TextBlock Text="РАЗВАЛ З" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.Caster, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Caster]}"/>
                                        <TextBlock Text="КАСТЕР" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ToeFront, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Toe]}"/>
                                        <TextBlock Text="СХОЖД. П" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ToeRear, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Toe]}"/>
                                        <TextBlock Text="СХОЖД. З" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ARB -->
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="СТАБИЛИЗАТОРЫ (ARB)" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ARBFront, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[ARB]}"/>
                                        <TextBlock Text="ПЕРЕД" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ARBRear, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[ARB]}"/>
                                        <TextBlock Text="ЗАД" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Springs + Ride Height -->
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="ПРУЖИНЫ" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ПЕРЕД"
                                               Style="{StaticResource ParamLabel}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Style="{StaticResource ValueDisplay}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding TuneResult.Explanations[Springs]}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource UV}" ConverterParameter="spring">
                                                <Binding Path="TuneResult.SpringFront"/>
                                                <Binding Path="SpringUnit"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ЗАД"
                                               Style="{StaticResource ParamLabel}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Style="{StaticResource ValueDisplay}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding TuneResult.Explanations[Springs]}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource UV}" ConverterParameter="spring">
                                                <Binding Path="TuneResult.SpringRear"/>
                                                <Binding Path="SpringUnit"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="КЛИРЕНС" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[RideHeight]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="height">
                                                    <Binding Path="TuneResult.RideHeightFront"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="ПЕРЕД" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[RideHeight]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="height">
                                                    <Binding Path="TuneResult.RideHeightRear"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="ЗАД" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Dampers: 2×2 grid (rebound top row, bump bottom row) -->
                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="АМОРТИЗАТОРЫ (1–20)" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Rebound row -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ReboundFront, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Dampers]}"/>
                                        <TextBlock Text="ОТБОЙ П" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ReboundRear, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Dampers]}"/>
                                        <TextBlock Text="ОТБОЙ З" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <!-- Bump row -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.BumpFront, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Dampers]}"/>
                                        <TextBlock Text="СЖАТИЕ П" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.BumpRear, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Dampers]}"/>
                                        <TextBlock Text="СЖАТИЕ З" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Aero -->
                        <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="АЭРОДИНАМИКА" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Aero]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="mass">
                                                    <Binding Path="TuneResult.AeroFront"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="ПЕРЕД" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Aero]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="mass">
                                                    <Binding Path="TuneResult.AeroRear"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="ЗАД" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Differential -->
                        <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="ДИФФЕРЕНЦИАЛ (%)" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <!-- Main (rear/FWD) diff -->
                                <TextBlock Text="Задний / основной" Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.DiffAccel, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                        <TextBlock Text="РАЗГОН" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.DiffDecel, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                        <TextBlock Text="ТОРМОЖЕНИЕ" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </Grid>
                                <!-- AWD front diff + centre bias -->
                                <StackPanel Visibility="{Binding HasAWDFrontDiff, Converter={StaticResource B2V}}">
                                    <Separator Margin="0,4"/>
                                    <TextBlock Text="ЦЕНТР. ДИФФ (AWD)" Foreground="{StaticResource AccentBrush}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding TuneResult.CenterDiffBias, StringFormat='{}{0:F0}%'}"
                                                   Style="{StaticResource ValueDisplay}" FontSize="18"
                                                   ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                        <TextBlock Text="СМЕЩЕНИЕ ЦЕНТРА" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <Separator Margin="0,4"/>
                                    <TextBlock Text="Передний (AWD)" Foreground="{StaticResource TextDimBrush}"
                                               FontSize="10" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TuneResult.DiffFrontAccel, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                       ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                            <TextBlock Text="РАЗГОН" Style="{StaticResource ParamLabel}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TuneResult.DiffFrontDecel, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                       ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                            <TextBlock Text="ТОРМОЖЕНИЕ" Style="{StaticResource ParamLabel}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Brakes -->
                        <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="ТОРМОЗА" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.BrakeBalance, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Brakes]}"/>
                                        <TextBlock Text="БАЛАНС П" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.BrakePressure, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Brakes]}"/>
                                        <TextBlock Text="ДАВЛЕНИЕ" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Gearing — full width -->
                        <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="ТРАНСМИССИЯ" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,24,4">
                                        <TextBlock Text="{Binding TuneResult.FinalDrive, StringFormat='{}{0:F2}'}"
                                                   Style="{StaticResource ValueDisplay}" FontSize="20"
                                                   ToolTip="{Binding TuneResult.Explanations[FinalDrive]}"/>
                                        <TextBlock Text="ГЛАВНАЯ ПАРА" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,24,4">
                                        <TextBlock Text="{Binding TuneResult.ActualMaxSpeedKmh, StringFormat='{}~{0:F0}'}"
                                                   Style="{StaticResource ValueDisplay}" FontSize="20"
                                                   Foreground="{StaticResource CyanBrush}"
                                                   ToolTip="~ Расчётная максимальная скорость при данных передаточных числах и оборотах"/>
                                        <TextBlock Text="КМ/Ч (МАКС.)" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,24,4">
                                        <TextBlock Text="{Binding TuneResult.RecommendedGearCount}"
                                                   Style="{StaticResource ValueDisplay}" FontSize="20"
                                                   ToolTip="{Binding TuneResult.Explanations[FinalDrive]}"/>
                                        <TextBlock Text="РЕК. ПЕРЕДАЧ" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding TuneResult.GearRatios}"
                                                  AlternationCount="100">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,14,4" HorizontalAlignment="Center"
                                                            ToolTip="{Binding DataContext.TuneResult.Explanations[FinalDrive], RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock Text="{Binding StringFormat='{}{0:F2}'}"
                                                               Style="{StaticResource ValueDisplay}" FontSize="16"/>
                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AddOne}, StringFormat='{}Передача {0}'}"
                                                               Style="{StaticResource ParamLabel}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                </WrapPanel>
                                <views:GearChartView Height="240"
                                    GearRatios="{Binding TuneResult.GearRatios}"
                                    FinalDrive="{Binding TuneResult.FinalDrive}"
                                    MaxRPM="{Binding TuneResult.Car.MaxRPM}"
                                    PowerPeakRPM="{Binding TuneResult.Car.PowerPeakRPM}"
                                    TorquePeakRPM="{Binding TuneResult.Car.TorquePeakRPM}"
                                    WheelDiameterInch="{Binding TuneResult.Car.RearWheelDiameterInch}"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
