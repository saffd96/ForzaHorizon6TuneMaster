<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.TuneResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Forza_Horizon_6_Tune_Master.Views"
             xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <cv:NullToVisibilityConverter        x:Key="N2V"/>
        <cv:InverseBoolToVisibilityConverter x:Key="IBV"/>
        <cv:BoolToVisibilityConverter        x:Key="B2V"/>
        <cv:UnitValueConverter               x:Key="UV"/>
        <cv:AddOneConverter                  x:Key="AddOne"/>
        <cv:DateDisplayConverter            x:Key="DateDisplay"/>
        <cv:GenericEnumLabelConverter       x:Key="EnumLabel"/>
        <cv:ValueToRangeConverter           x:Key="VTR"/>

        <!-- FontSize scales live with panel width via code-behind DynamicResource -->
        <Style x:Key="ValueDisplay" TargetType="TextBlock" BasedOn="{StaticResource ValueDisplay}">
            <Setter Property="FontSize" Value="{DynamicResource ValueFontSize}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{l:Loc ResultHeader}" Style="{StaticResource SubtitleText}"
                           FontSize="14" FontWeight="Bold"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding IsOverlayMode}"
                              Content="{l:Loc OverlayCheckbox}"
                              Foreground="{StaticResource CyanBrush}"
                              VerticalAlignment="Center"
                              FontSize="11" Margin="0,0,8,0"/>
                    <CheckBox IsChecked="{Binding IsAutoGenerate}"
                              Content="{l:Loc AutoCheckbox}"
                              Foreground="{StaticResource TextDimBrush}"
                              VerticalAlignment="Center"
                              FontSize="11" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content ───────────────────────────────────────────────── -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource IBV}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🏎" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="{l:Loc EmptyStateText}"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{l:Loc EmptyStateHint}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Result -->
            <ScrollViewer Visibility="{Binding HasResult, Converter={StaticResource B2V}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,8,8,12">

                    <!-- Header card -->
                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="0,0,0,2"
                            CornerRadius="8,8,0,0"
                            Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding TuneResult.Car.Name, FallbackValue='—'}"
                                           FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                                    <Run Text="{Binding TuneResult.Car.Make, FallbackValue=''}"    Foreground="{StaticResource TextDimBrush}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding TuneResult.Car.Model, FallbackValue=''}"   Foreground="{StaticResource TextDimBrush}"/>
                                    <Run Text="  •  "                            Foreground="{StaticResource TextMutedBrush}"/>
                                     <Run Text="{Binding TuneResult.Track.Discipline, Converter={StaticResource EnumLabel}}" Foreground="{StaticResource AccentBrush}"/>
                                     <Run Text="  •  "                            Foreground="{StaticResource TextMutedBrush}"/>
                                     <Run Text="{Binding TuneResult.Track.Season, Converter={StaticResource EnumLabel}}"     Foreground="{StaticResource AccentBrush}"/>
                                     <Run Text="  •  "                            Foreground="{StaticResource TextMutedBrush}"/>
                                     <Run Text="{Binding TuneResult.Car.DriveType, Converter={StaticResource EnumLabel}}"    Foreground="{StaticResource CyanBrush}"/>
                                    <Run Text="  "/>
                                    <Run Foreground="{StaticResource TextDimBrush}">
                                        <Run.Text>
                                            <MultiBinding Converter="{StaticResource UV}" ConverterParameter="power">
                                                <Binding Path="TuneResult.Car.PowerHP"/>
                                                <Binding Path="PowerUnit"/>
                                            </MultiBinding>
                                        </Run.Text>
                                    </Run>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{l:Loc ResultCreatedHeader}"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" TextAlignment="Right"/>
                                <TextBlock Text="{Binding TuneResult.CreatedAt, Converter={StaticResource DateDisplay}}"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── 2-column parameter grid ──────────────── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tire Pressure -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ResultTirePressure}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[TirePressure]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="pressure">
                                                    <Binding Path="TuneResult.TirePressureFront"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{l:Loc ResultTirePressureFront}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.TirePressureFront"/>
                                                    <Binding Path="Constraints.TirePressureFrontMin"/>
                                                    <Binding Path="Constraints.TirePressureFrontMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                     </StackPanel>
                                     <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                         <TextBlock Style="{StaticResource ValueDisplay}"
                                                    ToolTip="{Binding TuneResult.Explanations[TirePressure]}">
                                             <TextBlock.Text>
                                                 <MultiBinding Converter="{StaticResource UV}" ConverterParameter="pressure">
                                                     <Binding Path="TuneResult.TirePressureRear"/>
                                                     <Binding Path="UseImperial"/>
                                                 </MultiBinding>
                                             </TextBlock.Text>
                                         </TextBlock>
                                         <TextBlock Text="{l:Loc ResultTirePressureRear}" Style="{StaticResource ParamLabel}"/>
                                         <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                      Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                             <ProgressBar.Value>
                                                 <MultiBinding Converter="{StaticResource VTR}">
                                                     <Binding Path="TuneResult.TirePressureRear"/>
                                                     <Binding Path="Constraints.TirePressureRearMin"/>
                                                     <Binding Path="Constraints.TirePressureRearMax"/>
                                                 </MultiBinding>
                                             </ProgressBar.Value>
                                         </ProgressBar>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Geometry -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ResultGeometry}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <!-- Camber -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.CamberFront, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Camber]}"/>
                                        <TextBlock Text="{l:Loc ResultCamberFront}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.CamberFront"/>
                                                    <Binding Path="Constraints.CamberFrontMin"/>
                                                    <Binding Path="Constraints.CamberFrontMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.CamberRear, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Camber]}"/>
                                        <TextBlock Text="{l:Loc ResultCamberRear}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.CamberRear"/>
                                                    <Binding Path="Constraints.CamberRearMin"/>
                                                    <Binding Path="Constraints.CamberRearMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                                <!-- Toe -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ToeFront, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Toe]}"/>
                                        <TextBlock Text="{l:Loc ResultToeFront}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.ToeFront"/>
                                                    <Binding Path="Constraints.ToeFrontMin"/>
                                                    <Binding Path="Constraints.ToeFrontMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ToeRear, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Toe]}"/>
                                        <TextBlock Text="{l:Loc ResultToeRear}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.ToeRear"/>
                                                    <Binding Path="Constraints.ToeRearMin"/>
                                                    <Binding Path="Constraints.ToeRearMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                                <!-- Caster -->
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TuneResult.Caster, StringFormat='{}{0:F1}°'}" Style="{StaticResource ValueDisplay}"
                                               ToolTip="{Binding TuneResult.Explanations[Caster]}"/>
                                    <TextBlock Text="{l:Loc ResultCaster}" Style="{StaticResource ParamLabel}"/>
                                    <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                        <ProgressBar.Value>
                                            <MultiBinding Converter="{StaticResource VTR}">
                                                <Binding Path="TuneResult.Caster"/>
                                                <Binding Path="Constraints.CasterMin"/>
                                                <Binding Path="Constraints.CasterMax"/>
                                            </MultiBinding>
                                        </ProgressBar.Value>
                                    </ProgressBar>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ARB -->
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ResultARB}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ARBFront, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[ARB]}"/>
                                        <TextBlock Text="{l:Loc ResultARBFront}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.ARBFront"/>
                                                    <Binding Path="Constraints.ARBFrontMin"/>
                                                    <Binding Path="Constraints.ARBFrontMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ARBRear, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[ARB]}"/>
                                        <TextBlock Text="{l:Loc ResultARBRear}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.ARBRear"/>
                                                    <Binding Path="Constraints.ARBRearMin"/>
                                                    <Binding Path="Constraints.ARBRearMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Springs + Ride Height -->
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ResultSprings}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Loc ResultSpringFront}"
                                                Style="{StaticResource ParamLabel}"
                                                HorizontalAlignment="Center" TextAlignment="Center"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding TuneResult.Explanations[Springs]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="spring">
                                                    <Binding Path="TuneResult.SpringFront"/>
                                                    <Binding Path="SpringUnit"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.SpringFront"/>
                                                    <Binding Path="Constraints.SpringFrontMin"/>
                                                    <Binding Path="Constraints.SpringFrontMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Loc ResultSpringRear}"
                                                Style="{StaticResource ParamLabel}"
                                                HorizontalAlignment="Center" TextAlignment="Center"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding TuneResult.Explanations[Springs]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="spring">
                                                    <Binding Path="TuneResult.SpringRear"/>
                                                    <Binding Path="SpringUnit"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.SpringRear"/>
                                                    <Binding Path="Constraints.SpringRearMin"/>
                                                    <Binding Path="Constraints.SpringRearMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{l:Loc ResultRideHeight}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[RideHeight]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="height">
                                                    <Binding Path="TuneResult.RideHeightFront"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{l:Loc ResultRideHeightFront}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.RideHeightFront"/>
                                                    <Binding Path="Constraints.RideHeightFrontMin"/>
                                                    <Binding Path="Constraints.RideHeightFrontMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[RideHeight]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="height">
                                                    <Binding Path="TuneResult.RideHeightRear"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{l:Loc ResultRideHeightRear}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.RideHeightRear"/>
                                                    <Binding Path="Constraints.RideHeightRearMin"/>
                                                    <Binding Path="Constraints.RideHeightRearMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Dampers: 2×2 grid (rebound top row, bump bottom row) -->
                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ResultDampers}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Rebound row -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ReboundFront, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Dampers]}"/>
                                        <TextBlock Text="{l:Loc ResultReboundFront}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.ReboundFront"/>
                                                    <Binding Path="Constraints.ReboundFrontMin"/>
                                                    <Binding Path="Constraints.ReboundFrontMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.ReboundRear, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Dampers]}"/>
                                        <TextBlock Text="{l:Loc ResultReboundRear}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.ReboundRear"/>
                                                    <Binding Path="Constraints.ReboundRearMin"/>
                                                    <Binding Path="Constraints.ReboundRearMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <!-- Bump row -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.BumpFront, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Dampers]}"/>
                                        <TextBlock Text="{l:Loc ResultBumpFront}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.BumpFront"/>
                                                    <Binding Path="Constraints.BumpFrontMin"/>
                                                    <Binding Path="Constraints.BumpFrontMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.BumpRear, StringFormat='{}{0:F0}'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Dampers]}"/>
                                        <TextBlock Text="{l:Loc ResultBumpRear}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.BumpRear"/>
                                                    <Binding Path="Constraints.BumpRearMin"/>
                                                    <Binding Path="Constraints.BumpRearMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Aero -->
                        <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ResultAero}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Aero]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="aero">
                                                    <Binding Path="TuneResult.AeroFront"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{l:Loc ResultAeroFront}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.AeroFront"/>
                                                    <Binding Path="Constraints.AeroFrontMin"/>
                                                    <Binding Path="Constraints.AeroFrontMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Aero]}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="aero">
                                                    <Binding Path="TuneResult.AeroRear"/>
                                                    <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{l:Loc ResultAeroRear}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.AeroRear"/>
                                                    <Binding Path="Constraints.AeroRearMin"/>
                                                    <Binding Path="Constraints.AeroRearMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Differential -->
                        <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ResultDiff}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <!-- Front diff (AWD only) -->
                                <StackPanel Visibility="{Binding HasAWDFrontDiff, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{l:Loc ResultDiffFront}" Foreground="{StaticResource TextDimBrush}"
                                                FontSize="10" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding TuneResult.DiffFrontAccel, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                       ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                            <TextBlock Text="{l:Loc ResultDiffAccel}" Style="{StaticResource ParamLabel}"/>
                                            <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                                <ProgressBar.Value>
                                                    <MultiBinding Converter="{StaticResource VTR}">
                                                        <Binding Path="TuneResult.DiffFrontAccel"/>
                                                        <Binding Path="Constraints.DiffAccelMin"/>
                                                        <Binding Path="Constraints.DiffAccelMax"/>
                                                    </MultiBinding>
                                                </ProgressBar.Value>
                                            </ProgressBar>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                                    Visibility="{Binding HasDiffDecel, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding TuneResult.DiffFrontDecel, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                       ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                            <TextBlock Text="{l:Loc ResultDiffDecel}" Style="{StaticResource ParamLabel}"/>
                                            <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                                <ProgressBar.Value>
                                                    <MultiBinding Converter="{StaticResource VTR}">
                                                        <Binding Path="TuneResult.DiffFrontDecel"/>
                                                        <Binding Path="Constraints.DiffDecelMin"/>
                                                        <Binding Path="Constraints.DiffDecelMax"/>
                                                    </MultiBinding>
                                                </ProgressBar.Value>
                                            </ProgressBar>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <!-- Rear diff -->
                                <TextBlock Text="{l:Loc ResultDiffRear}" Foreground="{StaticResource TextDimBrush}"
                                            FontSize="10" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.DiffAccel, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                        <TextBlock Text="{l:Loc ResultDiffAccel}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.DiffAccel"/>
                                                    <Binding Path="Constraints.DiffAccelMin"/>
                                                    <Binding Path="Constraints.DiffAccelMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                                Visibility="{Binding HasDiffDecel, Converter={StaticResource B2V}}">
                                        <TextBlock Text="{Binding TuneResult.DiffDecel, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                        <TextBlock Text="{l:Loc ResultDiffDecel}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.DiffDecel"/>
                                                    <Binding Path="Constraints.DiffDecelMin"/>
                                                    <Binding Path="Constraints.DiffDecelMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                                <!-- Center bias (AWD only) -->
                                <StackPanel Visibility="{Binding HasAWDFrontDiff, Converter={StaticResource B2V}}">
                                    <TextBlock Text="{l:Loc ResultDiffCenter}" Foreground="{StaticResource AccentBrush}"
                                                FontSize="10" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding TuneResult.CenterDiffBias, StringFormat='{}{0:F0}%'}"
                                                   Style="{StaticResource ValueDisplay}" FontSize="18"
                                                   ToolTip="{Binding TuneResult.Explanations[Differential]}"/>
                                        <TextBlock Text="{l:Loc ResultDiffCenterBias}" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Brakes -->
                        <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ResultBrakes}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.BrakeBalance, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Brakes]}"/>
                                        <TextBlock Text="{l:Loc ResultBrakeBalance}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.BrakeBalance"/>
                                                    <Binding Path="Constraints.BrakeBalanceMin"/>
                                                    <Binding Path="Constraints.BrakeBalanceMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TuneResult.BrakePressure, StringFormat='{}{0:F0}%'}" Style="{StaticResource ValueDisplay}"
                                                   ToolTip="{Binding TuneResult.Explanations[Brakes]}"/>
                                        <TextBlock Text="{l:Loc ResultBrakePressure}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.BrakePressure"/>
                                                    <Binding Path="Constraints.BrakePressureMin"/>
                                                    <Binding Path="Constraints.BrakePressureMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Gearing — full width -->
                        <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ParamCard}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc ResultGearing}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,24,4">
                                        <TextBlock Text="{Binding TuneResult.FinalDrive, StringFormat='{}{0:F2}'}"
                                                   Style="{StaticResource ValueDisplay}" FontSize="20"
                                                   ToolTip="{Binding TuneResult.Explanations[FinalDrive]}"/>
                                        <TextBlock Text="{l:Loc ResultFinalDrive}" Style="{StaticResource ParamLabel}"/>
                                        <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}" BorderThickness="0">
                                            <ProgressBar.Value>
                                                <MultiBinding Converter="{StaticResource VTR}">
                                                    <Binding Path="TuneResult.FinalDrive"/>
                                                    <Binding Path="Constraints.FinalDriveMin"/>
                                                    <Binding Path="Constraints.FinalDriveMax"/>
                                                </MultiBinding>
                                            </ProgressBar.Value>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,24,4">
                                        <TextBlock Style="{StaticResource ValueDisplay}" FontSize="20"
                                                   Foreground="{StaticResource CyanBrush}"
                                                   ToolTip="{l:Loc ResultMaxSpeedTooltip}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UV}" ConverterParameter="speed">
                                                    <Binding Path="TuneResult.ActualMaxSpeedKmh"/>
                                                     <Binding Path="UseImperial"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{l:Loc ResultMaxSpeed}" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,24,4">
                                        <TextBlock Text="{Binding TuneResult.RecommendedGearCount}"
                                                   Style="{StaticResource ValueDisplay}" FontSize="20"
                                                   ToolTip="{Binding TuneResult.Explanations[FinalDrive]}"/>
                                        <TextBlock Text="{l:Loc ResultRecGears}" Style="{StaticResource ParamLabel}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding TuneResult.GearRatios}"
                                                  AlternationCount="10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,14,4" HorizontalAlignment="Center"
                                                            ToolTip="{Binding DataContext.TuneResult.Explanations[FinalDrive], RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock Text="{Binding StringFormat='{}{0:F2}'}"
                                                               Style="{StaticResource ValueDisplay}" FontSize="16"/>
                                                    <TextBlock Style="{StaticResource ParamLabel}">
                                                        <Run Text="{l:Loc ResultGearFormat}"/>
                                                        <Run Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AddOne}, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <ProgressBar Height="4" Width="60" Margin="0,3,0,0" Minimum="0.5" Maximum="5.0"
                                                                 Value="{Binding Mode=OneWay}" Foreground="{StaticResource AccentBrush}"
                                                                 Background="{StaticResource BorderBrush}" BorderThickness="0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                     </ItemsControl>
                                 </WrapPanel>

                                <!-- ── Launch Control (Drag only) ────────────── -->
                                <Border Visibility="{Binding HasLaunchControl, Converter={StaticResource B2V}}"
                                        Background="{StaticResource ElevatedBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="3,0,0,0"
                                        CornerRadius="6" Margin="0,0,0,8" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{l:Loc LaunchControlHeader}"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="10"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                        Text="{l:Loc LaunchControlHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Margin="12,0,2,0">
                                            <TextBlock Text="{Binding TuneResult.LaunchControlRpm, StringFormat='{}{0:F0}'}"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{l:Loc LaunchControlRpm}" Style="{StaticResource ParamLabel}"
                                                        Foreground="{StaticResource AccentBrush}" FontSize="9"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <views:GearChartView Height="240"
                                    GearRatios="{Binding TuneResult.GearRatios}"
                                    FinalDrive="{Binding TuneResult.FinalDrive}"
                                    MaxRPM="{Binding TuneResult.Car.MaxRPM}"
                                    PowerPeakRPM="{Binding TuneResult.Car.PowerPeakRPM}"
                                    TorquePeakRPM="{Binding TuneResult.Car.TorquePeakRPM}"
                                    WheelDiameterInch="{Binding TuneResult.Car.RearWheelDiameterInch}"
                                    ActualMaxSpeedKmh="{Binding TuneResult.ActualMaxSpeedKmh}"
                                    UseImperial="{Binding UseImperial}"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
