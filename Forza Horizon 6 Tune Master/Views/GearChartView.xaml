<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.GearChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
             Background="{StaticResource CardBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,8,0,0">
            <Canvas x:Name="ChartCanvas" ClipToBounds="True"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
            <Rectangle Width="16" Height="3" Fill="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Text="{l:Loc GearLegendTrajectory}" Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Line X1="0" Y1="0" X2="16" Y2="0" Stroke="#70EF4444" StrokeThickness="1.5"
                  StrokeDashArray="6,4" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Text="{l:Loc ChartRevLimitLabel}" Foreground="#9AEF4444"
                       FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Line X1="0" Y1="0" X2="16" Y2="0" Stroke="#9922C55E" StrokeThickness="1.5"
                  StrokeDashArray="5,4" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Text="{l:Loc GearLegendMaxSpeed}" Foreground="#A022C55E"
                       FontSize="10" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
