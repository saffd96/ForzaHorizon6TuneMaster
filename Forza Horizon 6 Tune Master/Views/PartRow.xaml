<UserControl x:Class="Forza_Horizon_6_Tune_Master.Views.PartRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Label, ElementName=Root}"
                   Style="{StaticResource PartRowLabel}"
                   ToolTip="{Binding Label, ElementName=Root}"/>
        <Border Grid.Column="1"
                BorderBrush="{Binding Selected.IsStock, Converter={StaticResource BoolToBorderBrush}, ElementName=Root}"
                BorderThickness="2" CornerRadius="3" Padding="1">
            <ComboBox Height="28" MinHeight="28"
                      FontSize="{DynamicResource FontSmall}"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Options, ElementName=Root}"
                      SelectedItem="{Binding Selected, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Border>
    </Grid>
</UserControl>
