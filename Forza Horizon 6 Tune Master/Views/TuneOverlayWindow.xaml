<Window x:Class="Forza_Horizon_6_Tune_Master.Views.TuneOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Forza_Horizon_6_Tune_Master.Views"
        xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="420" Height="560"
        MinWidth="300" MinHeight="300"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <Style x:Key="CornerThumb" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Line X1="0" Y1="14" X2="14" Y2="0"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.5"/>
                            <Line X1="4" Y1="14" X2="14" Y2="4"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EdgeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Border CornerRadius="10"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Opacity="{Binding OverlayOpacity}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="16" ShadowDepth="4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ══ Header / drag handle ═══════════════════════════════ -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="10,10,0,0"
                        Padding="12,6"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{l:Loc ResultHeader}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"/>

                        <Slider Grid.Column="2"
                                Value="{Binding OverlayOpacity}"
                                Minimum="0.3" Maximum="1.0"
                                Width="100"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                ToolTip="{l:Loc OverlayOpacityTooltip}"/>

                        <Button Grid.Column="3"
                                Content="✕"
                                Style="{StaticResource SecondaryButton}"
                                Width="24" Height="24"
                                Padding="0"
                                FontSize="12"
                                FontWeight="Bold"
                                Click="CloseButton_Click"/>
                    </Grid>
                </Border>

                <!-- ══ Content ═══════════════════════════════════════════ -->
                <views:TuneResultView Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- ══ Resize thumbs — 4 edges ════════════════════════════════════ -->
        <Thumb HorizontalAlignment="Stretch" VerticalAlignment="Top"
               Cursor="SizeNS" Height="5" Margin="14,0,14,0"
               Style="{StaticResource EdgeThumb}"
               DragDelta="ResizeThumb_Top"/>
        <Thumb HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Cursor="SizeNS" Height="5" Margin="14,0,14,0"
               Style="{StaticResource EdgeThumb}"
               DragDelta="ResizeThumb_Bottom"/>
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Cursor="SizeWE" Width="5" Margin="0,14,0,14"
               Style="{StaticResource EdgeThumb}"
               DragDelta="ResizeThumb_Left"/>
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Cursor="SizeWE" Width="5" Margin="0,14,0,14"
               Style="{StaticResource EdgeThumb}"
               DragDelta="ResizeThumb_Right"/>

        <!-- ══ Resize thumbs — 4 corners ══════════════════════════════════ -->
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE" Margin="0,0,2,2"
               Style="{StaticResource CornerThumb}"
               DragDelta="ResizeThumb_BR"/>
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Cursor="SizeNESW" Margin="2,0,0,2"
               Style="{StaticResource CornerThumb}"
               DragDelta="ResizeThumb_BL"/>
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Top"
               Cursor="SizeNESW" Margin="0,2,2,0"
               Style="{StaticResource CornerThumb}"
               DragDelta="ResizeThumb_TR"/>
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Top"
               Cursor="SizeNWSE" Margin="2,2,0,0"
               Style="{StaticResource CornerThumb}"
               DragDelta="ResizeThumb_TL"/>
    </Grid>
</Window>
