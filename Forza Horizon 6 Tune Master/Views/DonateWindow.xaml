<Window x:Class="Forza_Horizon_6_Tune_Master.Views.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
        Title="{l:Loc DonateWindowTitle}"
        Width="560" Height="680"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <TextBlock Text="{l:Loc DonateTitle}"
                       FontSize="{DynamicResource FontHeading}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,18">
            <StackPanel>
                <TextBlock Text="{l:Loc DonateDescription}"
                           FontSize="{DynamicResource FontNormal}"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,18"/>

                <!-- QR Code -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,18"
                        HorizontalAlignment="Center">
                    <Image Source="/Assets/dalink-qr-code.png"
                           Width="240"
                           Height="240"
                           Stretch="Uniform"/>
                </Border>

                <!-- Donation link -->
                <TextBlock Text="{l:Loc DonateLinkLabel}"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,6"/>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <TextBlock FontSize="{DynamicResource FontNormal}"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontFamily="Consolas">
                        <Hyperlink NavigateUri="https://dalink.to/saffd"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextDecorations="Underline">
                            https://dalink.to/saffd
                        </Hyperlink>
                    </TextBlock>
                </Border>

                <TextBlock Text="{l:Loc DonateThankYou}"
                           FontSize="{DynamicResource FontNormal}"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           FontStyle="Italic"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Close button -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <Button Content="{l:Loc DonateClose}"
                    Style="{StaticResource SecondaryButton}"
                    Padding="24,6"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="CloseButton_Click"/>
        </Border>
    </Grid>
</Window>
