<Window x:Class="Forza_Horizon_6_Tune_Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Forza_Horizon_6_Tune_Master.Views"
        xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
        xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
        Title="{l:Loc MainTitle}"
        Width="1400" Height="860"
        MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/icon.ico"/>
    </Window.Icon>

    <Window.Resources>
        <cv:EqualityConverter x:Key="Eq"/>
        <cv:EqualityVisibilityConverter x:Key="EqVis"/>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="BoolToCollapsed"/>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar —  2-row, auto-sizes to content -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══ Title Bar ════════════════════════════════════════════════ -->
        <!-- 2-row layout: row 0 = logo + units/lang (right), row 1 = profiles (centered). -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Logo | Version + Units/Language (right) -->
                <Grid Grid.Row="0" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="32" Height="32" Margin="0,0,12,0">
                            <Canvas Width="32" Height="32">
                                <Rectangle Width="32" Height="32" Fill="#0C0E16" RadiusX="6" RadiusY="6"/>
                                <Ellipse Canvas.Left="11" Canvas.Top="1.5" Width="10" Height="10" Fill="#1ABCFE" Opacity="0.9"/>
                                <Rectangle Canvas.Left="3"  Canvas.Top="10"  Width="26" Height="3.5" Fill="#FF5E0E" RadiusX="1" RadiusY="1"/>
                                <Rectangle Canvas.Left="6.5" Canvas.Top="16" Width="19" Height="2.5" Fill="#FF5E0E"/>
                                <Rectangle Canvas.Left="7.5" Canvas.Top="10" Width="4"  Height="20" Fill="#FF5E0E"/>
                                <Rectangle Canvas.Left="20.5" Canvas.Top="10" Width="4"  Height="20" Fill="#FF5E0E"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc AppTitleLine1}" Style="{StaticResource SubtitleText}"/>
                            <TextBlock Text="{l:Loc AppTitleLine2}" FontSize="{DynamicResource FontHeading}" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Units/Language + Version (right side) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8">
                        <TextBlock Text="{l:Loc UnitToggleLabel}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding UnitSystemOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedUnitSystemItem}"
                                  MinWidth="120" Margin="0,0,4,0"
                                  ToolTip="{l:Loc UnitTooltip}"/>
                        <ComboBox ItemsSource="{Binding PowerUnitOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedPowerUnitItem}"
                                  MinWidth="70" Margin="0,0,4,0"
                                  ToolTip="{l:Loc PowerUnitTooltip}"/>
                        <ComboBox ItemsSource="{Binding SpringUnitOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedSpringUnitItem}"
                                  MinWidth="100"
                                  ToolTip="{l:Loc SpringUnitTooltip}"/>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,2"/>
                        <TextBlock Text="{l:Loc LanguageLabel}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedLanguageItem}"
                                  MinWidth="100"/>
                        <Button x:Name="DonateHeartButton"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,3" Margin="10,0,0,0"
                                FontWeight="Bold" FontSize="{DynamicResource FontNormal}"
                                ToolTip="{l:Loc DonateButtonTooltip}"
                                Click="DonateButton_Click">
                            <TextBlock x:Name="HeartIcon"
                                       Text="❤">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="#8892A4"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="HeartIcon"
                                                            Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                            From="#8892A4" To="#FF5E0E"
                                                            Duration="0:0:0.75"
                                                            AutoReverse="True"
                                                            RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Content="{l:Loc HelpSymbol}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,3" Margin="10,0,0,0"
                                FontWeight="Bold" FontSize="{DynamicResource FontNormal}"
                                ToolTip="{l:Loc HelpButtonTooltip}"
                                Click="HelpButton_Click"/>
                        <TextBlock Text="{l:Loc VersionTag}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Profile management (centered) -->
                <Border Grid.Row="1"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,4">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{l:Loc ProfilesLabel}" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                        <Grid VerticalAlignment="Center">
                            <TextBox x:Name="ProfileSearchBox"
                                     Text="{Binding ProfileSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="140"
                                     Background="{StaticResource ElevatedBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     GotFocus="ProfileSearchBox_GotFocus"
                                     LostFocus="ProfileSearchBox_LostFocus" />
                            <Popup x:Name="ProfileDropdownPopup"
                                   PlacementTarget="{Binding ElementName=ProfileSearchBox}"
                                   Placement="Bottom"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource ElevatedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        MaxHeight="180">
                                    <ListBox x:Name="ProfileListBox"
                                             ItemsSource="{Binding FilteredProfiles}"
                                             SelectedItem="{Binding SelectedProfile}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionChanged="ProfileListBox_SelectionChanged" />
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Content="{l:Loc ProfileSave}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SaveCommand}" Margin="6,0,0,0" Padding="10,5"/>
                        <Button Content="{l:Loc ProfileLoad}"    Style="{StaticResource SecondaryButton}"
                                Command="{Binding LoadCommand}" Margin="4,0,0,0" Padding="10,5"/>
                        <Button Content="{l:Loc ProfileDelete}"   Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteProfileCommand}" Margin="4,0,0,0" Padding="10,5"/>
                        <Button Content="{l:Loc ProfileNew}"      Style="{StaticResource SecondaryButton}"
                                Command="{Binding NewProfileCommand}" Margin="4,0,0,0" Padding="10,5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Main Content ═════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════ LEFT PANEL (2/3) ════════════════════════════ -->
            <Grid Grid.Column="0" Margin="0,0,1,0" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>       <!-- Content -->
                    <RowDefinition Height="Auto"/>    <!-- Bottom bar -->
                </Grid.RowDefinitions>

                <!-- Content area: Car -->
                <views:CarCardView Grid.Row="0"
                    DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"/>

                <!-- Bottom bar: discipline + generate + auto -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <views:TrackInfoView/>
                </Border>
            </Grid>

            <!-- ════════ RIGHT PANEL (1/3) ═══════════════════════════ -->
            <Border Grid.Column="1"
                    Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <views:TuneResultView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"/>
            </Border>
        </Grid>

        <!-- ══ Busy overlay ════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
              ZIndex="100"
              IsHitTestVisible="True">
            <Rectangle Fill="#000000" Opacity="0.55"/>
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40,32"
                    Width="280"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="6"
                                 Margin="0,0,0,20"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource ElevatedBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding BusyMessage}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ AI Spec Status overlay ═══════════════════════════════════ -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding HasAiSpecStatus, Converter={StaticResource BoolVis}}"
              ZIndex="99"
              IsHitTestVisible="True"
              PreviewMouseDown="AiSpecStatusOverlay_PreviewMouseDown">
            <Rectangle Fill="#000000" Opacity="0.55"/>
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40,32"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AiSpecStatusMessage}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ Status Bar ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center"
                       Margin="16,0"/>
        </Border>

    </Grid>
</Window>
