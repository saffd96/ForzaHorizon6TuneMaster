<Window x:Class="Forza_Horizon_6_Tune_Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Forza_Horizon_6_Tune_Master.Views"
        xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
        xmlns:l="clr-namespace:Forza_Horizon_6_Tune_Master.Services"
        Title="{l:Loc MainTitle}"
        MinWidth="900" MinHeight="560"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource BgBrush}">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/icon.ico"/>
    </Window.Icon>

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Whole UI scales proportionally with the window (base design 2560×1440, 16:9).
         Stretch="Fill" => scales independently on each axis for non-16:9 windows. -->
    <Viewbox Stretch="Fill">
    <Grid Width="2560" Height="1440" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="Auto"/> <!-- Profiles / actions bar -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══ Title Bar ════════════════════════════════════════════════ -->
        <!-- 2-row layout: row 0 = logo + units/lang (right), row 1 = profiles (centered). -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <!-- Logo | Units/Language (right) -->
                <Grid Margin="20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="32" Height="32" Margin="0,0,12,0">
                            <Canvas Width="32" Height="32">
                                <Rectangle Width="32" Height="32" Fill="#0C0E16" RadiusX="6" RadiusY="6"/>
                                <Ellipse Canvas.Left="11" Canvas.Top="1.5" Width="10" Height="10" Fill="#1ABCFE" Opacity="0.9"/>
                                <Rectangle Canvas.Left="3"  Canvas.Top="10"  Width="26" Height="3.5" Fill="#FF5E0E" RadiusX="1" RadiusY="1"/>
                                <Rectangle Canvas.Left="6.5" Canvas.Top="16" Width="19" Height="2.5" Fill="#FF5E0E"/>
                                <Rectangle Canvas.Left="7.5" Canvas.Top="10" Width="4"  Height="20" Fill="#FF5E0E"/>
                                <Rectangle Canvas.Left="20.5" Canvas.Top="10" Width="4"  Height="20" Fill="#FF5E0E"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc AppTitleLine1}" Style="{StaticResource SubtitleText}"/>
                            <TextBlock Text="{l:Loc AppTitleLine2}" FontSize="{DynamicResource FontHeading}" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Units/Language + Version (right side) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8">
                        <TextBlock Text="{l:Loc UnitToggleLabel}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding UnitSystemOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedUnitSystemItem}"
                                  MinWidth="120" Margin="0,0,4,0"
                                  ToolTip="{l:Loc UnitTooltip}"/>
                        <ComboBox ItemsSource="{Binding PowerUnitOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedPowerUnitItem}"
                                  MinWidth="70" Margin="0,0,4,0"
                                  ToolTip="{l:Loc PowerUnitTooltip}"/>
                        <ComboBox ItemsSource="{Binding SpringUnitOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedSpringUnitItem}"
                                  MinWidth="100"
                                  ToolTip="{l:Loc SpringUnitTooltip}"/>
                        <Separator Margin="8,2"/>
                        <TextBlock Text="{l:Loc LanguageLabel}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedLanguageItem}"
                                  MinWidth="100"/>
                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="{l:Loc HelpSymbol}"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="34" Padding="0" Margin="2,0"
                                    FontWeight="Bold" FontSize="{DynamicResource FontNormal}"
                                    ToolTip="{l:Loc HelpButtonTooltip}"
                                    Click="HelpButton_Click"/>
                            <Button x:Name="DonateHeartButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="34" Padding="0" Margin="2,0"
                                    FontWeight="Bold" FontSize="{DynamicResource FontNormal}"
                                    ToolTip="{l:Loc DonateButtonTooltip}"
                                    Click="DonateButton_Click">
                                <TextBlock x:Name="HeartIcon"
                                            Text="{l:Loc DonateSymbol}">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="#8892A4"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="HeartIcon"
                                                                Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                                From="#8892A4" To="#FF5E0E"
                                                                Duration="0:0:0.75"
                                                                AutoReverse="True"
                                                                RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Content="{l:Loc FeedbackSymbol}"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="34" Padding="0" Margin="2,0"
                                    FontWeight="Bold" FontSize="{DynamicResource FontNormal}"
                                    ToolTip="{l:Loc FeedbackButtonTooltip}"
                                    Click="FeedbackButton_Click"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AppVersion}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <Separator Margin="8,2"/>
                        <TextBlock Text="{l:Loc FontLabel}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="+" Style="{StaticResource SecondaryButton}"
                                Width="30" Padding="0" Margin="2,0"
                                FontWeight="Bold" FontSize="{DynamicResource FontNormal}"
                                ToolTip="{l:Loc FontIncreaseTooltip}"
                                Click="FontIncrease_Click"/>
                        <Button Content="−" Style="{StaticResource SecondaryButton}"
                                Width="30" Padding="0" Margin="2,0"
                                FontWeight="Bold" FontSize="{DynamicResource FontNormal}"
                                ToolTip="{l:Loc FontDecreaseTooltip}"
                                Click="FontDecrease_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ Main Content ═════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════ LEFT PANEL (parts) ════════════════════════════ -->
            <Grid Grid.Column="0" Margin="0,0,1,0" ClipToBounds="True"
                  DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Pinned car search -->
                    <RowDefinition Height="*"/>      <!-- Scrolling accordions -->
                </Grid.RowDefinitions>

                <!-- Pinned car search (always on top) -->
                <Border Grid.Row="0" Background="{StaticResource BgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <StackPanel>
                        <Label Content="{l:Loc CarSearchLabel}"/>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="CarSearchBox"
                                     Text="{Binding CarSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     GotFocus="CarSearchBox_GotFocus"
                                     LostFocus="CarSearchBox_LostFocus"/>
                            <Button Grid.Column="1" Content="✕"
                                    Style="{StaticResource IconButton}"
                                    Width="26" Height="26"
                                    Margin="4,0,0,0"
                                    Command="{Binding ClearCarSelectionCommand}"
                                    Visibility="{Binding SelectedCar, Converter={StaticResource NullVis}}"/>
                            <Popup x:Name="CarDropdownPopup"
                                   PlacementTarget="{Binding ElementName=CarSearchBox}"
                                   Placement="Bottom"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide"
                                   HorizontalOffset="-2">
                                <Border Background="{StaticResource ElevatedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=CarSearchBox}"
                                        MaxHeight="280">
                                    <ListBox x:Name="CarListBox"
                                             ItemsSource="{Binding FilteredCarDatabase}"
                                             DisplayMemberPath="DisplayName"
                                             SelectedItem="{Binding SelectedCar}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionChanged="CarListBox_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="CarListItem_PreviewMouseLeftButtonDown"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Scrolling accordions -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8">
                            <StackPanel Visibility="{Binding IsElectricCar, Converter={StaticResource BoolToCollapsed}}">
                                <Expander Style="{StaticResource AccordionExpander}" Header="{l:Loc ModuleSwaps}">
                                    <views:SwapsView DataContext="{Binding SwapsVM}"/>
                                </Expander>
                                <Expander Style="{StaticResource AccordionExpander}" Header="{l:Loc ModuleEngine}">
                                    <views:EnginePartsView DataContext="{Binding EngineVM}"/>
                                </Expander>
                            </StackPanel>
                            <Expander Style="{StaticResource AccordionExpander}" Header="{l:Loc ModuleElectric}"
                                      Visibility="{Binding IsElectricCar, Converter={StaticResource BoolVis}}">
                                <views:MotorPartsView DataContext="{Binding MotorVM}"/>
                            </Expander>
                            <Expander Style="{StaticResource AccordionExpander}" Header="{l:Loc ModuleChassis}">
                                <views:SuspensionView DataContext="{Binding SuspensionVM}"/>
                            </Expander>
                            <Expander Style="{StaticResource AccordionExpander}" Header="{l:Loc ModuleTransmission}">
                                <views:TransmissionView DataContext="{Binding TransmissionVM}"/>
                            </Expander>
                            <Expander Style="{StaticResource AccordionExpander}" Header="{l:Loc ModuleTiresWheels}">
                                <views:TiresWheelsView DataContext="{Binding TiresWheelsVM}"/>
                            </Expander>
                            <Expander Style="{StaticResource AccordionExpander}" Header="{l:Loc ModuleAero}">
                                <views:AeroVisualView DataContext="{Binding AeroVisualVM}"/>
                            </Expander>
                        </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ════════ RIGHT PANEL (1/3) ═══════════════════════════ -->
            <Border Grid.Column="1"
                    Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <views:TuneResultView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"
                                      Visibility="{Binding IsOverlayMode, Converter={StaticResource BoolToCollapsed}}"/>
            </Border>
        </Grid>

        <!-- ══ Busy overlay ════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="4"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
              ZIndex="100"
              IsHitTestVisible="True">
            <Rectangle Fill="#000000" Opacity="0.55"/>
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40,32"
                    Width="280"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="6"
                                 Margin="0,0,0,20"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource ElevatedBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding BusyMessage}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>



        <!-- ══ Profiles / actions bar ══════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc ProfilesLabel}" Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" FontSize="{DynamicResource FontXSmall}"/>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="ProfileSearchBox"
                             Text="{Binding ProfileSearchText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="130" Height="24" Padding="6,2" FontSize="{DynamicResource FontXSmall}"
                             Background="{StaticResource ElevatedBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             GotFocus="ProfileSearchBox_GotFocus"
                             LostFocus="ProfileSearchBox_LostFocus" />
                    <Button Grid.Column="1" Content="✕"
                            Style="{StaticResource IconButton}"
                            Width="22" Height="22"
                            Margin="4,0,0,0"
                            Click="ClearProfileSelection_Click"
                            Visibility="{Binding SelectedProfile, Converter={StaticResource NullVis}}"/>
                    <Popup x:Name="ProfileDropdownPopup"
                           PlacementTarget="{Binding ElementName=ProfileSearchBox}"
                           Placement="Top"
                           StaysOpen="True"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                        <Border Background="{StaticResource ElevatedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                MaxHeight="220">
                            <ListBox x:Name="ProfileListBox"
                                     ItemsSource="{Binding FilteredProfiles}"
                                     SelectedItem="{Binding SelectedProfile}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="ProfileListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ProfileListItem_PreviewMouseLeftButtonDown"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <Button Content="{l:Loc ProfileSave}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SaveCommand}" Margin="6,0,0,0" Padding="9,3"/>
                <Button Content="{l:Loc ProfileLoad}" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}" Margin="4,0,0,0" Padding="9,3"/>
                <Button Content="{l:Loc ProfileDelete}" Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteProfileCommand}" Margin="4,0,0,0" Padding="9,3"/>
                <Button Content="{l:Loc ProfileDeleteAll}" Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteAllProfilesCommand}" Margin="4,0,0,0" Padding="9,3"/>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center"
                           Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- ══ Status Bar ══════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center"
                       Margin="16,0"/>
        </Border>

    </Grid>
    </Viewbox>
</Window>
