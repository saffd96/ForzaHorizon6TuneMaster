<Window x:Class="Forza_Horizon_6_Tune_Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Forza_Horizon_6_Tune_Master.Views"
        xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
        Title="Forza Horizon 6 Tune Master"
        Width="1400" Height="860"
        MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/icon.ico"/>
    </Window.Icon>

    <Window.Resources>
        <cv:EqualityConverter x:Key="Eq"/>
        <cv:EqualityVisibilityConverter x:Key="EqVis"/>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="BoolToCollapsed"/>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar —  2-row, auto-sizes to content -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══ Title Bar ════════════════════════════════════════════════ -->
        <!-- 2-row layout: row 0 = logo + profiles, row 1 = unit toggles.
             Fixes overflow at MinWidth=1100 where single-row approach squeezed
             profiles into <480px (needs ~580px). -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Logo | Profile management | Version -->
                <Grid Grid.Row="0" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="32" Height="32" Margin="0,0,12,0">
                            <Canvas Width="32" Height="32">
                                <Rectangle Width="32" Height="32" Fill="#0C0E16" RadiusX="6" RadiusY="6"/>
                                <Ellipse Canvas.Left="11" Canvas.Top="1.5" Width="10" Height="10" Fill="#1ABCFE" Opacity="0.9"/>
                                <Rectangle Canvas.Left="3"  Canvas.Top="10"  Width="26" Height="3.5" Fill="#FF5E0E" RadiusX="1" RadiusY="1"/>
                                <Rectangle Canvas.Left="6.5" Canvas.Top="16" Width="19" Height="2.5" Fill="#FF5E0E"/>
                                <Rectangle Canvas.Left="7.5" Canvas.Top="10" Width="4"  Height="20" Fill="#FF5E0E"/>
                                <Rectangle Canvas.Left="20.5" Canvas.Top="10" Width="4"  Height="20" Fill="#FF5E0E"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FORZA HORIZON 6" Style="{StaticResource SubtitleText}"/>
                            <TextBlock Text="TUNE MASTER" FontSize="{DynamicResource FontHeading}" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Profile Management — centered, now has full * column (~810px at min width) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Профили:" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  MinWidth="140"
                                  Background="{StaticResource ElevatedBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  VerticalAlignment="Center"/>
                        <Button Content="💾 Сохранить" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SaveCommand}" Margin="6,0,0,0" Padding="10,5"/>
                        <Button Content="Загрузить"    Style="{StaticResource SecondaryButton}"
                                Command="{Binding LoadCommand}" Margin="4,0,0,0" Padding="10,5"/>
                        <Button Content="🗑 Удалить"   Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteProfileCommand}" Margin="4,0,0,0" Padding="10,5"/>
                        <Button Content="+ Новый"      Style="{StaticResource SecondaryButton}"
                                Command="{Binding NewProfileCommand}" Margin="4,0,0,0" Padding="10,5"/>
                    </StackPanel>

                    <!-- Version tag -->
                    <TextBlock Grid.Column="2" Text="MVP v1.0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Row 1: Unit toggles sub-bar -->
                <Border Grid.Row="1"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Единицы:" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding UnitSystemOptions}"
                                  SelectedItem="{Binding SelectedUnitSystemItem}"
                                  MinWidth="120" Margin="0,0,4,0"
                                  ToolTip="Метрическая / Имперская система мер"/>
                        <ComboBox ItemsSource="{Binding PowerUnitOptions}"
                                  SelectedItem="{Binding SelectedPowerUnitItem}"
                                  MinWidth="70" Margin="0,0,4,0"
                                  ToolTip="л.с. / PS / кВт"/>
                        <ComboBox ItemsSource="{Binding SpringUnitOptions}"
                                  SelectedItem="{Binding SelectedSpringUnitItem}"
                                  MinWidth="100"
                                  ToolTip="кгс/мм / Н/мм / фунт/дюйм"/>
                        <Button Content="?"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,3" Margin="10,0,0,0"
                                FontWeight="Bold" FontSize="{DynamicResource FontNormal}"
                                ToolTip="Как пользоваться Tune Master"
                                Click="HelpButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Main Content ═════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════ LEFT PANEL (2/3) ════════════════════════════ -->
            <Grid Grid.Column="0" Margin="0,0,1,0" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>       <!-- Content -->
                    <RowDefinition Height="Auto"/>    <!-- Bottom bar -->
                </Grid.RowDefinitions>

                <!-- Content area: Car -->
                <views:CarCardView Grid.Row="0"
                    DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"/>

                <!-- Bottom bar: discipline + generate + auto -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Discipline selector -->
                        <views:TrackInfoView Grid.Column="0"/>

                        <!-- Generate button (hidden when auto-generate is on) -->
                        <Button Grid.Column="1"
                                Content="⚡  Сгенерировать"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GenerateCommand}"
                                FontSize="{DynamicResource FontNormal}" Padding="20,8"
                                Visibility="{Binding IsAutoGenerate, Converter={StaticResource BoolToCollapsed}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ════════ RIGHT PANEL (1/3) ═══════════════════════════ -->
            <Border Grid.Column="1"
                    Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <views:TuneResultView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"/>
            </Border>
        </Grid>

        <!-- ══ Busy overlay ════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
              ZIndex="100"
              IsHitTestVisible="True">
            <Rectangle Fill="#000000" Opacity="0.55"/>
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40,32"
                    Width="280"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="6"
                                 Margin="0,0,0,20"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource ElevatedBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding BusyMessage}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ Status Bar ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage, TargetNullValue='Готов'}"
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="{DynamicResource FontXSmall}" VerticalAlignment="Center"
                       Margin="16,0"/>
        </Border>

    </Grid>
</Window>
