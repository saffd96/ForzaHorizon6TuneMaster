<Application x:Class="Forza_Horizon_6_Tune_Master.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Forza_Horizon_6_Tune_Master.Converters"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cv:EqualityConverter x:Key="Eq"/>
            <cv:EqualityVisibilityConverter x:Key="EqVis"/>
            <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
            <cv:InverseBoolToVisibilityConverter x:Key="BoolToCollapsed"/>
            <cv:NullToVisibilityConverter x:Key="NullVis"/>
            <cv:CountToVisibilityConverter x:Key="CountVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
